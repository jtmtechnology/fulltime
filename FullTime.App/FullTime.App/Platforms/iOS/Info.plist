<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
        <integer>2</integer>
    </array>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>XSAppIconAssets</key>
    <string>Assets.xcassets/appicon.appiconset</string>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>
    <!-- The API itself is plain HTTP with no domain yet (see FullTime.Api/Program.cs's own comment
         on this) — regular API calls already work today, likely because .NET's default HTTP stack
         on iOS doesn't enforce ATS the same way SignalR.Client's connection does internally (same
         asymmetry confirmed on Android: SignalR failed with a cleartext block that the app's own
         HttpClient never hit). Added pre-emptively so the SignalR live-score push doesn't silently
         fail the same way on a real iPhone. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <!-- Google's published TEST AdMob app ID - swap for the real one from the AdMob console before
         releasing to the App Store. Real submission will also need an NSUserTrackingUsageDescription
         (App Tracking Transparency prompt) and Google's SKAdNetworkItems list added - neither is
         needed to build/test with the TEST ID, but both are required before going live with ads. -->
    <key>GADApplicationIdentifier</key>
    <string>ca-app-pub-3940256099942544~1458002511</string>
    <key>GADIsAdManagerApp</key>
    <true/>
</dict>
</plist>
