@page "/"
@implements IDisposable
@inject ApiClient Api
@inject MatchLeaguePreferences Prefs
@inject MatchUpdatesClient MatchUpdates
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>FullTime — Matches</PageTitle>

<FreeSpinBanner />
<BetBuilderBoostBanner />

<h1>Matches</h1>

<div class="day-picker">
    @foreach (var day in _days)
    {
        <button type="button" class="day-pill @(day == _selectedDate ? "selected" : "")" @onclick="() => SelectDateAsync(day)">@DayLabel(day)</button>
    }
</div>

@if (_leagues is { Count: > 0 })
{
    <div class="league-list">
        <div class="league-list-row league-list-header">
            <span class="league-list-text">
                <span class="league-list-name">All competitions</span>
            </span>
            <span class="league-list-count">@_leagues.Sum(l => l.Matches.Count)</span>
        </div>
        @foreach (var league in _leagues)
        {
            var liveCount = league.Matches.Count(m => m.Status == "InProgress");
            <button type="button" class="league-list-row" @onclick="() => OpenLeague(league.LeagueId)">
                <LogoImg Src="@LeagueCatalog.LogoUrl(league.LeagueId)" Alt="@LeagueCatalog.Name(league.LeagueId)" />
                <span class="league-list-text">
                    <span class="league-list-name">@LeagueCatalog.Name(league.LeagueId)</span>
                    @if (!string.IsNullOrEmpty(LeagueCatalog.Country(league.LeagueId)))
                    {
                        <span class="league-list-country">@LeagueCatalog.Country(league.LeagueId)</span>
                    }
                </span>
                @if (liveCount > 0)
                {
                    <span class="league-list-live">@liveCount</span>
                }
                <span class="league-list-count">@league.Matches.Count</span>
            </button>
        }
    </div>
}

@if (_status == "Loading…")
{
    <LoadingSpinner />
}
else if (!string.IsNullOrEmpty(_status))
{
    <div class="status @(_error ? "error" : "")">@_status</div>
}

@foreach (var dateGroup in VisibleMatches())
{
    <h3 class="match-date">@dateGroup.Key.ToString("dddd d MMMM")</h3>
    @foreach (var leagueGroup in dateGroup.GroupBy(m => LeagueCatalog.GroupKey(m.LeagueId)))
    {
        <div class="league-header">
            <LogoImg Src="@LeagueCatalog.LogoUrl(leagueGroup.Key)" Alt="@LeagueCatalog.Name(leagueGroup.Key)" />
            <span>@LeagueCatalog.Name(leagueGroup.Key)</span>
        </div>
        @foreach (var m in leagueGroup)
        {
            <MatchCard Match="m" ReturnUrl="@($"/?date={_selectedDate:yyyy-MM-dd}")" />
        }
    }
}

@code {
    private record LeagueGroup(long LeagueId, List<UpcomingMatchDto> Matches);

    // Yesterday through 7 days ahead - matches HighlightlyOptions.MatchSyncDaysAhead, so every tab
    // shown actually has a chance of having fixtures synced for it (no dead tabs past the sync
    // window that would always come back empty).
    private readonly List<DateOnly> _days = Enumerable.Range(-1, 9)
        .Select(i => DateOnly.FromDateTime(DateTime.Today.AddDays(i)))
        .ToList();

    // Set when navigating back from Bet Builder (see BetBuilder.razor's Cancel/AddToSlipAsync) so
    // returning lands back on the date the match card was on, instead of always resetting to today.
    [SupplyParameterFromQuery(Name = "date")] public string? Date { get; set; }

    private DateOnly _selectedDate = DateOnly.FromDateTime(DateTime.Today);
    private bool _hasQueried;
    private List<LeagueGroup>? _leagues;
    private string _status = "Loading…";
    private bool _error;
    private readonly CancellationTokenSource _cts = new();

    // Restores/tracks scroll position across leaving for Match Summary or Bet Builder and coming
    // back (see MatchCard.ReturnUrl) - keyed by date since that's the only thing that changes this
    // page's content. Blazor swaps content in place rather than doing a real browser navigation, so
    // there's no scroll restoration to lean on without this.
    private bool _scrollRestored;
    private string? _attachedScrollKey;
    private string ScrollKey => $"scroll:/:{_selectedDate:yyyy-MM-dd}";

    protected override async Task OnInitializedAsync()
    {
        if (DateOnly.TryParse(Date, out var requestedDate) && _days.Contains(requestedDate))
        {
            _selectedDate = requestedDate;
        }

        await Prefs.InitializeAsync();
        await LoadMatchesAsync(quiet: false);
        _ = AutoRefreshLoopAsync(_cts.Token);

        // Live score pushes on top of the poll loop above, which stays as a fallback if the
        // connection never establishes (e.g. a proxy blocking WebSockets) — a failure here must not
        // break the page.
        MatchUpdates.MatchUpdated += OnMatchUpdated;
        try
        {
            await MatchUpdates.EnsureStartedAsync();
        }
        catch
        {
            // Falls back to the existing poll loop.
        }
    }

    // Patches a displayed match card's score/status directly instead of waiting for the next poll.
    // UpcomingMatchDto is a positional record (init-only properties), so this replaces the entry
    // rather than mutating it in place.
    private void OnMatchUpdated(MatchLiveUpdate update)
    {
        if (_leagues is null)
        {
            return;
        }

        var changed = false;
        foreach (var group in _leagues)
        {
            var index = group.Matches.FindIndex(m => m.Id == update.MatchId);
            if (index < 0)
            {
                continue;
            }

            group.Matches[index] = group.Matches[index] with
            {
                Status = update.Status,
                HomeScore = update.HomeScore,
                AwayScore = update.AwayScore,
                Minute = update.Minute,
                AddedTimeMinutes = update.AddedTimeMinutes,
                IsHalfTime = update.IsHalfTime,
            };
            changed = true;
            break;
        }

        if (changed)
        {
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task SelectDateAsync(DateOnly day)
    {
        _selectedDate = day;
        await LoadMatchesAsync(quiet: false);
        await AttachScrollTrackingAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_leagues is not null && !_scrollRestored)
        {
            _scrollRestored = true;
            await AttachScrollTrackingAsync();
            try
            {
                await JS.InvokeVoidAsync("fullTimeScroll.restore", ScrollKey);
            }
            catch
            {
                // Best-effort - a page without the runtime attached yet (e.g. prerendering) just
                // skips the restore rather than breaking the page.
            }
        }
    }

    private async Task AttachScrollTrackingAsync()
    {
        if (_attachedScrollKey == ScrollKey)
        {
            return;
        }

        _attachedScrollKey = ScrollKey;
        try
        {
            await JS.InvokeVoidAsync("fullTimeScroll.attach", ScrollKey);
        }
        catch
        {
            // Best-effort, see above.
        }
    }

    private void OpenLeague(long leagueId) => Nav.NavigateTo($"/matches/league/{leagueId}?date={_selectedDate:yyyy-MM-dd}");

    private string DayLabel(DateOnly day)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (day == today) return "Today";
        if (day == today.AddDays(1)) return "Tomorrow";
        if (day == today.AddDays(-1)) return "Yesterday";
        return day.ToString("ddd d");
    }

    private async Task LoadMatchesAsync(bool quiet)
    {
        _hasQueried = true;

        if (!quiet)
        {
            _status = "Loading…";
            _error = false;
        }

        try
        {
            var matches = await Api.GetUpcomingMatchesAsync(_selectedDate);
            Render(matches);
        }
        catch (Exception ex)
        {
            _status = $"Error: {ex.Message}";
            _error = true;
        }

        await InvokeAsync(StateHasChanged);
    }

    // The periodic poll (AutoRefreshLoopAsync) and the SignalR push (OnMatchUpdated) both write into
    // _leagues independently. If a poll's HTTP round trip is slow enough that its response lands
    // after a faster, more recent SignalR push already advanced a match card, applying it would
    // overwrite the newer minute/score with the older one - confirmed happening as a visible
    // "minute drops then jumps back up" flicker. Guard against a poll regressing any match that's
    // currently displayed as InProgress with a higher minute than the poll just returned.
    private static bool IsPollRegression(UpcomingMatchDto? existing, UpcomingMatchDto incoming) =>
        existing is { Status: "InProgress", Minute: { } existingMinute }
        && incoming is { Status: "InProgress", Minute: { } incomingMinute }
        && incomingMinute < existingMinute;

    private void Render(List<UpcomingMatchDto> allMatches)
    {
        var previousById = (_leagues ?? []).SelectMany(l => l.Matches).ToDictionary(m => m.Id);

        var matches = allMatches
            .Where(m => Prefs.IsVisible(m.LeagueId))
            .Select(m => previousById.TryGetValue(m.Id, out var previous) && IsPollRegression(previous, m) ? previous : m)
            .ToList();

        if (matches.Count == 0)
        {
            _leagues = [];
            _status = "No matches found";
            _error = false;
            return;
        }

        _status = "";
        _error = false;

        var byLeague = matches.GroupBy(m => LeagueCatalog.GroupKey(m.LeagueId)).ToDictionary(g => g.Key, g => g.ToList());
        var orderedIds = LeagueCatalog.DisplayOrder.Where(byLeague.ContainsKey)
            .Concat(byLeague.Keys.Where(id => !LeagueCatalog.DisplayOrder.Contains(id)).OrderBy(id => id));

        _leagues = orderedIds.Select(id => new LeagueGroup(id, byLeague[id])).ToList();
    }

    private IEnumerable<IGrouping<DateOnly, UpcomingMatchDto>> VisibleMatches()
    {
        if (_leagues is null) return [];

        return _leagues.SelectMany(l => l.Matches)
            .OrderBy(m => DateOnly.FromDateTime(m.KickoffTime.ToLocalTime().Date))
            .ThenBy(m => LeagueSortRank(m.LeagueId))
            .ThenBy(m => m.LeagueId)
            .ThenBy(m => m.Status == "Finished" ? 1 : 0)
            .ThenBy(m => m.KickoffTime)
            .ThenBy(m => m.HomeTeam)
            .GroupBy(m => DateOnly.FromDateTime(m.KickoffTime.ToLocalTime().Date));
    }

    private static int LeagueSortRank(long leagueId)
    {
        var index = Array.IndexOf(LeagueCatalog.DisplayOrder, leagueId);
        return index >= 0 ? index : int.MaxValue;
    }

    private async Task AutoRefreshLoopAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            var seconds = 600;
            try
            {
                seconds = (await Api.GetConfigAsync()).RefreshIntervalSeconds;
            }
            catch
            {
                // fall back to the default above if /api/config isn't reachable
            }

            try
            {
                await Task.Delay(TimeSpan.FromSeconds(Math.Max(1, seconds)), ct);
            }
            catch (TaskCanceledException)
            {
                break;
            }

            if (_hasQueried)
            {
                await LoadMatchesAsync(quiet: true);
            }
        }
    }

    public void Dispose()
    {
        MatchUpdates.MatchUpdated -= OnMatchUpdated;
        _cts.Cancel();
        _cts.Dispose();
    }
}
