@page "/"
@implements IDisposable
@inject ApiClient Api

<PageTitle>FullTime — Matches</PageTitle>

<h1>Matches</h1>

<div class="day-picker">
    @foreach (var day in _days)
    {
        <button type="button" class="day-pill @(day == _selectedDate ? "selected" : "")" @onclick="() => SelectDateAsync(day)">@DayLabel(day)</button>
    }
</div>

@if (_leagues is { Count: > 0 })
{
    <div class="league-chips">
        <button type="button" class="league-chip @(_selectedLeagueId is null ? "selected" : "")" @onclick="() => SelectLeague(null)">All</button>
        @foreach (var league in _leagues)
        {
            <button type="button" class="league-chip @(_selectedLeagueId == league.LeagueId ? "selected" : "")" @onclick="() => SelectLeague(league.LeagueId)">
                <LogoImg Src="@LeagueLogoUrl(league.LeagueId)" Alt="@LeagueName(league.LeagueId)" />
                <span>@LeagueName(league.LeagueId)</span>
            </button>
        }
    </div>
}

<div class="status @(_error ? "error" : "")">@_status</div>

@foreach (var dateGroup in VisibleMatches())
{
    <h3 class="match-date">@dateGroup.Key.ToString("dddd d MMMM")</h3>
    @foreach (var m in dateGroup)
    {
        <MatchCard Match="m" />
    }
}

@code {
    // Known league/cup IDs this season. Some divisions are tagged under a provider-assigned
    // temporary ID until it links them to the canonical one — both are listed where that applies.
    private static readonly Dictionary<long, string> LeagueNames = new()
    {
        [47] = "Premier League",
        [48] = "Championship",
        [938218] = "Championship",
        [108] = "League One",
        [938219] = "League One",
        [109] = "League Two",
        [938220] = "League Two",
        [132] = "FA Cup",
        [133] = "EFL Cup",
        [938221] = "EFL Cup",
        [247] = "Community Shield",
    };

    private static readonly long[] LeagueOrder = [47, 48, 938218, 108, 938219, 109, 938220, 132, 133, 938221, 247];

    // The provider's temporary per-season league IDs (see LeagueNames above) have no logo asset of
    // their own yet — fall back to the canonical ID's logo, which does.
    private static readonly Dictionary<long, long> LeagueLogoId = new()
    {
        [938218] = 48,
        [938219] = 108,
        [938220] = 109,
        [938221] = 133,
    };

    private record LeagueGroup(long LeagueId, List<UpcomingMatchDto> Matches);

    private readonly List<DateOnly> _days = Enumerable.Range(0, 14)
        .Select(i => DateOnly.FromDateTime(DateTime.Today.AddDays(i)))
        .ToList();

    private DateOnly _selectedDate = DateOnly.FromDateTime(DateTime.Today);
    private long? _selectedLeagueId;
    private bool _hasQueried;
    private List<LeagueGroup>? _leagues;
    private string _status = "Loading…";
    private bool _error;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadMatchesAsync(quiet: false);
        _ = AutoRefreshLoopAsync(_cts.Token);
    }

    private async Task SelectDateAsync(DateOnly day)
    {
        _selectedDate = day;
        await LoadMatchesAsync(quiet: false);
    }

    private void SelectLeague(long? leagueId) => _selectedLeagueId = leagueId;

    private string DayLabel(DateOnly day)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (day == today) return "Today";
        if (day == today.AddDays(1)) return "Tomorrow";
        return day.ToString("ddd d");
    }

    private async Task LoadMatchesAsync(bool quiet)
    {
        _hasQueried = true;

        if (!quiet)
        {
            _status = "Loading…";
            _error = false;
        }

        try
        {
            var matches = await Api.GetUpcomingMatchesAsync(_selectedDate);
            Render(matches);
        }
        catch (Exception ex)
        {
            _status = $"Error: {ex.Message}";
            _error = true;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void Render(List<UpcomingMatchDto> matches)
    {
        if (matches.Count == 0)
        {
            _leagues = [];
            _status = "No matches found";
            _error = false;
            return;
        }

        _status = matches.Count == 1 ? "1 match" : $"{matches.Count} matches";
        _error = false;

        var byLeague = matches.GroupBy(m => m.LeagueId).ToDictionary(g => g.Key, g => g.ToList());
        var orderedIds = LeagueOrder.Where(byLeague.ContainsKey)
            .Concat(byLeague.Keys.Where(id => !LeagueOrder.Contains(id)).OrderBy(id => id));

        _leagues = orderedIds.Select(id => new LeagueGroup(id, byLeague[id])).ToList();

        if (_selectedLeagueId is not null && !_leagues.Any(l => l.LeagueId == _selectedLeagueId))
        {
            _selectedLeagueId = null;
        }
    }

    private IEnumerable<IGrouping<DateOnly, UpcomingMatchDto>> VisibleMatches()
    {
        if (_leagues is null) return [];

        var matches = _selectedLeagueId is null
            ? _leagues.SelectMany(l => l.Matches)
            : _leagues.Where(l => l.LeagueId == _selectedLeagueId).SelectMany(l => l.Matches);

        return matches
            .OrderBy(m => DateOnly.FromDateTime(m.KickoffTime.ToLocalTime().Date))
            .ThenBy(m => LeagueSortRank(m.LeagueId))
            .ThenBy(m => m.LeagueId)
            .ThenBy(m => m.KickoffTime)
            .ThenBy(m => m.HomeTeam)
            .GroupBy(m => DateOnly.FromDateTime(m.KickoffTime.ToLocalTime().Date));
    }

    private static int LeagueSortRank(long leagueId)
    {
        var index = Array.IndexOf(LeagueOrder, leagueId);
        return index >= 0 ? index : int.MaxValue;
    }

    private static string LeagueName(long leagueId) => LeagueNames.GetValueOrDefault(leagueId, $"League {leagueId}");

    private static string LeagueLogoUrl(long leagueId)
    {
        var id = LeagueLogoId.GetValueOrDefault(leagueId, leagueId);
        return $"https://images.fotmob.com/image_resources/logo/leaguelogo/{id}.png";
    }

    private async Task AutoRefreshLoopAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            var seconds = 600;
            try
            {
                seconds = (await Api.GetConfigAsync()).RefreshIntervalSeconds;
            }
            catch
            {
                // fall back to the default above if /api/config isn't reachable
            }

            try
            {
                await Task.Delay(TimeSpan.FromSeconds(Math.Max(1, seconds)), ct);
            }
            catch (TaskCanceledException)
            {
                break;
            }

            if (_hasQueried)
            {
                await LoadMatchesAsync(quiet: true);
            }
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
