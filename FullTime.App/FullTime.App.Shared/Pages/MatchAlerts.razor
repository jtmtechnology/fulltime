@page "/match-alerts"
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>FullTime — Match Alerts</PageTitle>

<div class="page-header-row">
    <button type="button" class="back-btn" @onclick="GoBack" aria-label="Back">‹</button>
    <h1>Match Alerts</h1>
</div>

@if (_status == "Loading…")
{
    <LoadingSpinner />
}
else
{
    <div class="status @(_error ? "error" : "")">@_status</div>

    <div class="page-card">
        <h2>Alert types</h2>
        <p class="hint">Which events you want a push notification for - applies to every team, league or match you pick below.</p>
        <div class="league-toggle-list">
            <label class="league-toggle">
                <input type="checkbox" checked="@_prefs.LineupsOut" @onchange="e => SetPreferenceAsync(p => p with { LineupsOut = (bool)e.Value! })" />
                <span>Lineups out</span>
            </label>
            <label class="league-toggle">
                <input type="checkbox" checked="@_prefs.Kickoff" @onchange="e => SetPreferenceAsync(p => p with { Kickoff = (bool)e.Value! })" />
                <span>Kick-off</span>
            </label>
            <label class="league-toggle">
                <input type="checkbox" checked="@_prefs.HalfTime" @onchange="e => SetPreferenceAsync(p => p with { HalfTime = (bool)e.Value! })" />
                <span>Half-time</span>
            </label>
            <label class="league-toggle">
                <input type="checkbox" checked="@_prefs.Goal" @onchange="e => SetPreferenceAsync(p => p with { Goal = (bool)e.Value! })" />
                <span>Goal</span>
            </label>
            <label class="league-toggle">
                <input type="checkbox" checked="@_prefs.RedCard" @onchange="e => SetPreferenceAsync(p => p with { RedCard = (bool)e.Value! })" />
                <span>Red card</span>
            </label>
            <label class="league-toggle">
                <input type="checkbox" checked="@_prefs.FullTime" @onchange="e => SetPreferenceAsync(p => p with { FullTime = (bool)e.Value! })" />
                <span>Full-time</span>
            </label>
        </div>
    </div>

    <div class="page-card">
        <h2>Favourite teams</h2>
        <p class="hint">Every match either of these teams plays gets alerts, in any competition.</p>
        <div class="league-toggle-list">
            @foreach (var team in _teams)
            {
                <label class="league-toggle">
                    <input type="checkbox" checked="@_favouriteTeamIds.Contains(team.TeamId)"
                           @onchange="e => ToggleFavouriteTeamAsync(team.TeamId, (bool)e.Value!)" />
                    <LogoImg Src="@team.LogoUrl" Alt="@team.TeamName" />
                    <span>@team.TeamName</span>
                </label>
            }
        </div>
    </div>

    <div class="page-card">
        <h2>Favourite leagues</h2>
        <p class="hint">Every match in these competitions gets alerts.</p>
        <div class="league-toggle-list">
            @foreach (var leagueId in LeagueCatalog.DisplayOrder)
            {
                <label class="league-toggle">
                    <input type="checkbox" checked="@_favouriteLeagueIds.Contains(leagueId)"
                           @onchange="e => ToggleFavouriteLeagueAsync(leagueId, (bool)e.Value!)" />
                    <LogoImg Src="@LeagueCatalog.LogoUrl(leagueId)" Alt="@LeagueCatalog.Name(leagueId)" />
                    <span>@LeagueCatalog.Name(leagueId)</span>
                </label>
            }
        </div>
    </div>

    <p class="hint">Individual matches can also be toggled directly from their bell icon on the Matches screen.</p>
}

@code {
    private AlertPreferencesDto _prefs = new(false, false, false, false, false, false);
    private List<AlertTeamDto> _teams = [];
    private HashSet<long> _favouriteTeamIds = [];
    private HashSet<long> _favouriteLeagueIds = [];
    private string _status = "Loading…";
    private bool _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _prefs = await Api.GetAlertPreferencesAsync();
            _teams = await Api.GetAlertTeamsAsync();
            var subscriptions = await Api.GetAlertSubscriptionsAsync();
            _favouriteTeamIds = subscriptions.FavouriteTeamIds.ToHashSet();
            _favouriteLeagueIds = subscriptions.FavouriteLeagueIds.ToHashSet();
            _status = "";
        }
        catch (Exception ex)
        {
            _status = $"Error: {ex.Message}";
            _error = true;
        }
    }

    private async Task SetPreferenceAsync(Func<AlertPreferencesDto, AlertPreferencesDto> update)
    {
        var previous = _prefs;
        _prefs = update(_prefs);

        try
        {
            _prefs = await Api.UpdateAlertPreferencesAsync(_prefs);
        }
        catch (Exception ex)
        {
            _prefs = previous;
            _status = $"Error: {ex.Message}";
            _error = true;
        }
    }

    private async Task ToggleFavouriteTeamAsync(long teamId, bool favourite)
    {
        if (favourite) _favouriteTeamIds.Add(teamId); else _favouriteTeamIds.Remove(teamId);

        try
        {
            await Api.SetFavouriteTeamAsync(teamId, favourite);
        }
        catch (Exception ex)
        {
            if (favourite) _favouriteTeamIds.Remove(teamId); else _favouriteTeamIds.Add(teamId);
            _status = $"Error: {ex.Message}";
            _error = true;
        }
    }

    private async Task ToggleFavouriteLeagueAsync(long leagueId, bool favourite)
    {
        if (favourite) _favouriteLeagueIds.Add(leagueId); else _favouriteLeagueIds.Remove(leagueId);

        try
        {
            await Api.SetFavouriteLeagueAsync(leagueId, favourite);
        }
        catch (Exception ex)
        {
            if (favourite) _favouriteLeagueIds.Remove(leagueId); else _favouriteLeagueIds.Add(leagueId);
            _status = $"Error: {ex.Message}";
            _error = true;
        }
    }

    private void GoBack() => Nav.NavigateTo("/profile");
}
