@page "/match-alerts"
@implements IDisposable
@inject ApiClient Api
@inject NavigationManager Nav
@inject MatchAlertSubscriptions AlertSubs

<PageTitle>FullTime — Match Alerts</PageTitle>

<div class="page-header-row">
    <button type="button" class="back-btn" @onclick="GoBack" aria-label="Back">‹</button>
    <h1>Match Alerts</h1>
</div>

@if (_status == "Loading…")
{
    <LoadingSpinner />
}
else
{
    <div class="status @(_error ? "error" : "")">@_status</div>

    <div class="page-card">
        <h2>Alert types</h2>
        <p class="hint">Which events you want a push notification for - applies to every team, league or match you pick below.</p>
        <div class="league-toggle-list">
            <label class="league-toggle">
                <input type="checkbox" checked="@_prefs.LineupsOut" @onchange="e => SetPreferenceAsync(p => p with { LineupsOut = (bool)e.Value! })" />
                <span>Lineups out</span>
            </label>
            <label class="league-toggle">
                <input type="checkbox" checked="@_prefs.Kickoff" @onchange="e => SetPreferenceAsync(p => p with { Kickoff = (bool)e.Value! })" />
                <span>Kick-off</span>
            </label>
            <label class="league-toggle">
                <input type="checkbox" checked="@_prefs.HalfTime" @onchange="e => SetPreferenceAsync(p => p with { HalfTime = (bool)e.Value! })" />
                <span>Half-time</span>
            </label>
            <label class="league-toggle">
                <input type="checkbox" checked="@_prefs.Goal" @onchange="e => SetPreferenceAsync(p => p with { Goal = (bool)e.Value! })" />
                <span>Goal</span>
            </label>
            <label class="league-toggle">
                <input type="checkbox" checked="@_prefs.YellowCard" @onchange="e => SetPreferenceAsync(p => p with { YellowCard = (bool)e.Value! })" />
                <span>Yellow card</span>
            </label>
            <label class="league-toggle">
                <input type="checkbox" checked="@_prefs.RedCard" @onchange="e => SetPreferenceAsync(p => p with { RedCard = (bool)e.Value! })" />
                <span>Red card</span>
            </label>
            <label class="league-toggle">
                <input type="checkbox" checked="@_prefs.FullTime" @onchange="e => SetPreferenceAsync(p => p with { FullTime = (bool)e.Value! })" />
                <span>Full-time</span>
            </label>
        </div>
    </div>

    <div class="page-card">
        <h2>Favourite teams</h2>
        <p class="hint">Every match either of these teams plays gets alerts, in any competition.</p>
        <div class="team-league-accordions">
        @foreach (var leagueId in _teamLeagueIds)
        {
            <AccordionSection Id="@leagueId.ToString()" Title="@LeagueCatalog.Name(leagueId)" TitleIconUrl="@LeagueCatalog.LogoUrl(leagueId)"
                               Expanded="_expandedTeamLeagues" OnToggle="ToggleTeamLeagueSection">
                <div class="league-toggle-list">
                    @foreach (var team in _teams.Where(t => t.LeagueId == leagueId))
                    {
                        <label class="league-toggle">
                            <input type="checkbox" checked="@AlertSubs.IsFavouriteTeam(team.TeamId)"
                                   @onchange="() => ToggleFavouriteTeamAsync(team.TeamId)" />
                            <LogoImg Src="@team.LogoUrl" Alt="@team.TeamName" />
                            <span>@team.TeamName</span>
                        </label>
                    }
                </div>
            </AccordionSection>
        }
        </div>
    </div>

    <div class="page-card">
        <h2>Favourite leagues</h2>
        <p class="hint">Every match in these competitions gets alerts.</p>
        <div class="league-toggle-list">
            @foreach (var leagueId in LeagueCatalog.LeaguesOnly)
            {
                <label class="league-toggle">
                    <input type="checkbox" checked="@AlertSubs.IsFavouriteLeague(leagueId)"
                           @onchange="() => ToggleFavouriteLeagueAsync(leagueId)" />
                    <LogoImg Src="@LeagueCatalog.LogoUrl(leagueId)" Alt="@LeagueCatalog.Name(leagueId)" />
                    <span>@LeagueCatalog.Name(leagueId)</span>
                </label>
            }
        </div>
    </div>

    <p class="hint match-alerts-footer-hint">Individual matches can also be toggled directly from their bell icon on the Matches screen.</p>
}

@code {
    private AlertPreferencesDto _prefs = new(false, false, false, false, false, false, false);
    private List<AlertTeamDto> _teams = [];
    private List<long> _teamLeagueIds = [];
    private readonly HashSet<string> _expandedTeamLeagues = [];
    private string _status = "Loading…";
    private bool _error;

    protected override async Task OnInitializedAsync()
    {
        AlertSubs.Changed += OnAlertSubsChanged;

        try
        {
            _prefs = await Api.GetAlertPreferencesAsync();
            _teams = await Api.GetAlertTeamsAsync();
            // Ordered to match LeagueCatalog.LeaguesOnly (Premier League first, etc.) rather than
            // however GetAlertTeamsAsync happened to return them - picking a league first only reads
            // as a shortcut, not a randomly-ordered new list to scan, if the order is one the user
            // already recognizes from the rest of the app (Matches' competition list, Profile's
            // league toggles). Cup competitions excluded here too, same reasoning as Favourite
            // leagues below - a team whose most-recently-seen match happens to be a cup tie just
            // won't get an accordion section for it, one team-picker edge case not worth a bigger
            // redesign of GetAlertTeamsAsync for.
            var presentLeagueIds = _teams.Select(t => t.LeagueId).ToHashSet();
            _teamLeagueIds = LeagueCatalog.LeaguesOnly.Where(presentLeagueIds.Contains).ToList();
            // Shared with MatchCard's bell icon rather than a separate local copy - this used to be
            // its own ApiClient call + local HashSet, which meant favouriting a team/league here
            // never reached the cache MatchCard actually reads from, so a newly-favourited league's
            // matches kept showing an unlit bell until the app restarted.
            await AlertSubs.InitializeAsync();
            _status = "";
        }
        catch (Exception ex)
        {
            _status = $"Error: {ex.Message}";
            _error = true;
        }
    }

    private void OnAlertSubsChanged() => InvokeAsync(StateHasChanged);

    private void ToggleTeamLeagueSection(string id)
    {
        if (!_expandedTeamLeagues.Remove(id))
        {
            _expandedTeamLeagues.Add(id);
        }
    }

    private async Task SetPreferenceAsync(Func<AlertPreferencesDto, AlertPreferencesDto> update)
    {
        var previous = _prefs;
        _prefs = update(_prefs);

        try
        {
            _prefs = await Api.UpdateAlertPreferencesAsync(_prefs);
        }
        catch (Exception ex)
        {
            _prefs = previous;
            _status = $"Error: {ex.Message}";
            _error = true;
        }
    }

    private async Task ToggleFavouriteTeamAsync(long teamId)
    {
        try
        {
            await AlertSubs.ToggleFavouriteTeamAsync(teamId);
        }
        catch (Exception ex)
        {
            _status = $"Error: {ex.Message}";
            _error = true;
        }
    }

    private async Task ToggleFavouriteLeagueAsync(long leagueId)
    {
        try
        {
            await AlertSubs.ToggleFavouriteLeagueAsync(leagueId);
        }
        catch (Exception ex)
        {
            _status = $"Error: {ex.Message}";
            _error = true;
        }
    }

    private void GoBack() => Nav.NavigateTo("/profile");

    public void Dispose() => AlertSubs.Changed -= OnAlertSubsChanged;
}
