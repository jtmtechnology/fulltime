@page "/forgot-password"
@inject ApiClient Api

<PageTitle>FullTime — Forgot Password</PageTitle>

<h1>Forgot password</h1>

<div class="page-card">
    <p class="muted">Enter your email and, if it's registered, a reset link will be sent (logged to the server console during local/dev use).</p>

    <EditForm Model="this" OnValidSubmit="SubmitAsync">
        <div class="field">
            <label for="email">Email</label>
            <InputText id="email" type="email" @bind-Value="_email" />
        </div>
        <button type="submit">Send reset link</button>
    </EditForm>

    <div class="status @(_error ? "error" : "")">@_status</div>
</div>

@code {
    private string _email = "";
    private string _status = "";
    private bool _error;

    private async Task SubmitAsync()
    {
        _status = "Sending…";
        _error = false;

        try
        {
            _status = await Api.ForgotPasswordAsync(_email);
        }
        catch (Exception ex)
        {
            _status = $"Error: {ex.Message}";
            _error = true;
        }
    }
}
