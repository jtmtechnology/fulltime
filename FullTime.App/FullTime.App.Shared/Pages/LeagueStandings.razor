@page "/matches/league/{LeagueId:long}/table"
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>FullTime — @LeagueCatalog.Name(LeagueId) Table</PageTitle>

<div class="page-header-row">
    <button type="button" class="back-btn" @onclick="GoBack" aria-label="Back">‹</button>
    <LogoImg Src="@LeagueCatalog.LogoUrl(LeagueId)" Alt="@LeagueCatalog.Name(LeagueId)" CssClass="league-header-crest" />
    <div class="league-header-text">
        <h1>@LeagueCatalog.Name(LeagueId)</h1>
        <span class="muted">Table</span>
    </div>
</div>

@if (_status == "Loading…")
{
    <LoadingSpinner />
}
else if (!string.IsNullOrEmpty(_status))
{
    <div class="status @(_error ? "error" : "")">@_status</div>
}
else
{
    <div class="standings-table">
        <div class="standings-row standings-header">
            <span class="standings-pos">#</span>
            <span class="standings-team">Team</span>
            <span class="standings-stat">P</span>
            <span class="standings-stat">GD</span>
            <span class="standings-stat">Pts</span>
        </div>
        @foreach (var s in _standings)
        {
            <div class="standings-row">
                <span class="standings-pos">@s.Position</span>
                <span class="standings-team">
                    <LogoImg Src="@s.CrestUrl" Alt="@s.TeamName" CssClass="standings-crest" />
                    <span class="standings-team-name">@s.TeamName</span>
                </span>
                <span class="standings-stat">@s.Played</span>
                <span class="standings-stat">@(s.GoalDifference > 0 ? $"+{s.GoalDifference}" : s.GoalDifference.ToString())</span>
                <span class="standings-stat standings-points">@s.Points</span>
            </div>
        }
    </div>
}

@code {
    [Parameter] public long LeagueId { get; set; }

    private List<TeamStandingDto> _standings = [];
    private string _status = "Loading…";
    private bool _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _standings = await Api.GetStandingsAsync(LeagueId);
            // A knockout-only competition and a genuine provider miss both come back empty from the
            // API - either way there's simply no table to show, not an error state.
            _status = _standings.Count == 0 ? "No table available for this competition" : "";
        }
        catch (Exception ex)
        {
            _status = $"Error: {ex.Message}";
            _error = true;
        }
    }

    private void GoBack() => Nav.NavigateTo($"/matches/league/{LeagueId}");
}
