@page "/mybets"
@inject ApiClient Api
@inject AuthState AuthState
@inject ActiveContextState ContextState
@inject NavigationManager Nav

<PageTitle>FullTime — My Bets</PageTitle>

<h1>My Bets</h1>

@if (_status == "Loading…")
{
    <LoadingSpinner />
}
else if (!string.IsNullOrEmpty(_status))
{
    <div class="status @(_error ? "error" : "")">@_status</div>
}

@if (_bets is not null)
{
    <BetList Bets="_bets" CurrencySymbol="@ContextState.CurrencySymbol" />
}

@code {
    private List<BetDto>? _bets;
    private string _status = "Loading…";
    private bool _error;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        try
        {
            _bets = await Api.GetMyBetsAsync();
            _status = _bets.Count == 0 ? "No bets placed yet." : "";
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            await AuthState.LogoutAsync();
            Nav.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            _status = $"Error: {ex.Message}";
            _error = true;
        }
    }

}
