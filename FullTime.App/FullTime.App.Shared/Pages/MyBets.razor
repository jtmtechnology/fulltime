@page "/mybets"
@inject ApiClient Api
@inject AuthState AuthState
@inject NavigationManager Nav

<PageTitle>FullTime — My Bets</PageTitle>

<h1>My Bets</h1>

@if (_status == "Loading…")
{
    <LoadingSpinner />
}
else if (!string.IsNullOrEmpty(_status))
{
    <div class="status @(_error ? "error" : "")">@_status</div>
}

@if (_bets is not null)
{
    @foreach (var bet in _bets)
    {
        <div class="bet-card">
            <div>
                <span class="context-badge">@(bet.LeagueName ?? "Worldwide")</span>
                <strong>@bet.PlacedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong> —
                Stake £@bet.Stake.ToString("0.00") ·
                Combined odds @bet.CombinedOdds.ToString("0.00") ·
                Potential return £@bet.PotentialReturn.ToString("0.00") ·
                <span class="@BetDisplay.StatusClass(bet.Status)">@bet.Status</span>
            </div>
            <ul>
                @foreach (var leg in bet.Legs)
                {
                    <li class="@BetDisplay.StatusClass(leg.Outcome)">
                        <span class="muted">@leg.KickoffTime.ToLocalTime().ToString("ddd d MMM HH:mm")</span> —
                        <LogoImg Src="@leg.HomeLogoUrl" CssClass="team-logo" Alt="@leg.HomeTeam" />@leg.HomeTeam v
                        <LogoImg Src="@leg.AwayLogoUrl" CssClass="team-logo" Alt="@leg.AwayTeam" />@leg.AwayTeam
                        — @string.Join(" + ", leg.Picks.Select(p => BetDisplay.PickLabel(p, leg.HomeTeam, leg.AwayTeam))) (@leg.Outcome)
                    </li>
                }
            </ul>
        </div>
    }
}

@code {
    private List<BetDto>? _bets;
    private string _status = "Loading…";
    private bool _error;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        try
        {
            _bets = await Api.GetMyBetsAsync();
            _status = _bets.Count == 0 ? "No bets placed yet." : "";
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            await AuthState.LogoutAsync();
            Nav.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            _status = $"Error: {ex.Message}";
            _error = true;
        }
    }

}
