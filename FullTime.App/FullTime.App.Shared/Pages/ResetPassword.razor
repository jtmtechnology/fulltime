@page "/reset-password"
@inject ApiClient Api

<PageTitle>FullTime — Reset Password</PageTitle>

<h1>Reset password</h1>

<div class="page-card">
    @if (string.IsNullOrEmpty(Token))
    {
        <div class="status error">No reset token in the link.</div>
    }
    else if (!_done)
    {
        <EditForm Model="this" OnValidSubmit="SubmitAsync">
            <div class="field">
                <label for="password">New password</label>
                <InputText id="password" type="password" @bind-Value="_password" />
            </div>
            <div class="field">
                <label for="confirm-password">Confirm new password</label>
                <InputText id="confirm-password" type="password" @bind-Value="_confirmPassword" />
            </div>
            <button type="submit">Reset password</button>
        </EditForm>
    }

    <div class="status @(_error ? "error" : "")">
        @_status
        @if (_done)
        {
            <text> </text><a href="login">Log in</a>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private string _password = "";
    private string _confirmPassword = "";
    private string _status = "";
    private bool _error;
    private bool _done;

    private async Task SubmitAsync()
    {
        if (_password != _confirmPassword)
        {
            _status = "Passwords do not match.";
            _error = true;
            return;
        }

        _status = "Resetting…";
        _error = false;

        try
        {
            _status = await Api.ResetPasswordAsync(Token!, _password);
            _done = true;
        }
        catch (Exception ex)
        {
            _status = $"Error: {ex.Message}";
            _error = true;
        }
    }
}
