@page "/profile"
@using System.Net
@inject ApiClient Api
@inject AuthState AuthState
@inject NavigationManager Nav
@inject MatchLeaguePreferences LeaguePrefs
@inject IAdsRemovalService AdsRemoval

<PageTitle>FullTime — Profile</PageTitle>

<h1>Profile</h1>

<div class="status @(_error ? "error" : "")">@_status</div>

<div class="page-card">
    <h2>Ads</h2>
    @if (AdsRemoval.AdsRemoved)
    {
        <p class="hint live">Ads removed — thanks for supporting FullTime!</p>
    }
    else
    {
        <p class="hint">Remove the ads shown on startup and after placing a bet with a one-off purchase.</p>
        <div class="button-row">
            <button type="button" class="primary-btn" disabled="@_purchasing" @onclick="PurchaseRemoveAdsAsync">Remove ads</button>
            <button type="button" class="cancel-btn" disabled="@_purchasing" @onclick="RestorePurchasesAsync">Restore purchase</button>
        </div>
        <div class="status @(_adsError ? "error" : "")">@_adsStatus</div>
    }
</div>

@if (_me is not null)
{
    <div class="page-card">
        <div class="stat-list">
            <div class="stat-row"><span class="label">Email</span><span>@_me.Email</span></div>
            <div class="stat-row"><span class="label">Verified</span><span class="@(_me.EmailVerified ? "live" : "error")">@(_me.EmailVerified ? "Yes" : "No")</span></div>
            <div class="stat-row"><span class="label">Joined</span><span>@_me.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</span></div>
            <div class="stat-row"><span class="label">Leagues</span><span>@LeagueSummary()</span></div>
        </div>

        <h2>Edit name</h2>
        <EditForm Model="this" OnValidSubmit="SaveNameAsync">
            <div class="field">
                <label for="name">Name</label>
                <InputText id="name" @bind-Value="_name" />
            </div>
            <button type="submit">Save name</button>
        </EditForm>
        <div class="status @(_nameError ? "error" : "")">@_nameStatus</div>

        <h2>Change password</h2>
        <EditForm Model="this" OnValidSubmit="ChangePasswordAsync">
            <div class="field">
                <label for="current-password">Current password</label>
                <InputText id="current-password" type="password" @bind-Value="_currentPassword" />
            </div>
            <div class="field">
                <label for="new-password">New password</label>
                <InputText id="new-password" type="password" @bind-Value="_newPassword" />
            </div>
            <button type="submit">Change password</button>
        </EditForm>
        <div class="status @(_passwordError ? "error" : "")">@_passwordStatus</div>

        <h2>Extra leagues</h2>
        <p class="hint">The Premier League and the English pyramid always show in Matches. Add other countries' top flights or the UEFA cups too:</p>
        <div class="league-toggle-list">
            @foreach (var league in LeagueCatalog.OptionalLeagues)
            {
                var primaryId = league.LeagueIds[0];
                <label class="league-toggle">
                    <input type="checkbox" checked="@LeaguePrefs.EnabledOptionalLeagueIds.Contains(primaryId)"
                           @onchange="e => ToggleLeagueAsync(primaryId, (bool)e.Value!)" />
                    <LogoImg Src="@LeagueCatalog.LogoUrl(primaryId)" Alt="@league.Name" />
                    <span>@league.Name</span>
                </label>
            }
        </div>
    </div>
}

@code {
    private MeDto? _me;
    private string _name = "";
    private string _nameStatus = "";
    private bool _nameError;
    private string _currentPassword = "";
    private string _newPassword = "";
    private string _passwordStatus = "";
    private bool _passwordError;
    private string _status = "";
    private bool _error;
    private List<LeagueSummaryDto>? _myLeagues;
    private bool _purchasing;
    private string _adsStatus = "";
    private bool _adsError;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        try
        {
            _me = await Api.GetMeAsync();
            _name = _me.Name;
            _myLeagues = await Api.GetMyLeaguesAsync();
            await LeaguePrefs.InitializeAsync();
        }
        catch (ApiException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            await AuthState.LogoutAsync();
            Nav.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            _status = $"Error: {ex.Message}";
            _error = true;
        }
    }

    private string LeagueSummary() =>
        _myLeagues is { Count: > 0 } ? string.Join(", ", _myLeagues.Select(l => l.Name)) : "None yet";

    private async Task SaveNameAsync()
    {
        _nameStatus = "Saving…";
        _nameError = false;

        try
        {
            _me = await Api.UpdateProfileAsync(_name, _me?.Country);
            _nameStatus = "Saved.";
        }
        catch (Exception ex)
        {
            _nameStatus = $"Error: {ex.Message}";
            _nameError = true;
        }
    }

    private async Task ChangePasswordAsync()
    {
        _passwordStatus = "Saving…";
        _passwordError = false;

        try
        {
            await Api.ChangePasswordAsync(_currentPassword, _newPassword);
            _currentPassword = "";
            _newPassword = "";
            _passwordStatus = "Password changed.";
        }
        catch (Exception ex)
        {
            _passwordStatus = $"Error: {ex.Message}";
            _passwordError = true;
        }
    }

    private async Task ToggleLeagueAsync(long leagueId, bool enabled)
    {
        await LeaguePrefs.SetEnabledAsync(leagueId, enabled);
    }

    private async Task PurchaseRemoveAdsAsync()
    {
        _purchasing = true;
        _adsStatus = "Processing…";
        _adsError = false;

        try
        {
            var bought = await AdsRemoval.PurchaseRemoveAdsAsync();
            _adsStatus = bought ? "" : "Purchase didn't complete — try again.";
            _adsError = !bought;
        }
        catch (Exception ex)
        {
            _adsStatus = $"Error: {ex.Message}";
            _adsError = true;
        }
        finally
        {
            _purchasing = false;
        }
    }

    private async Task RestorePurchasesAsync()
    {
        _purchasing = true;
        _adsStatus = "Checking for a previous purchase…";
        _adsError = false;

        try
        {
            var owned = await AdsRemoval.RestorePurchasesAsync();
            _adsStatus = owned ? "" : "No previous purchase found on this account.";
            _adsError = false;
        }
        catch (Exception ex)
        {
            _adsStatus = $"Error: {ex.Message}";
            _adsError = true;
        }
        finally
        {
            _purchasing = false;
        }
    }
}
