@implements IDisposable
@inject AuthState AuthState
@inject BetSlipState Slip

<nav class="tab-bar">
    <NavLink class="tab-item" href="" Match="NavLinkMatch.All">
        <svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0M12 7l4.76 3.45l-1.76 5.55h-6l-1.76 -5.55l4.76 -3.45M12 7v-4m3 13l2.5 3m-.74 -8.55l3.74 -1.45m-11.44 7.05l-2.56 2.95m.74 -8.55l-3.74 -1.45"/></svg>
        <span>Matches</span>
    </NavLink>

    <button type="button" class="tab-item @(Slip.IsOpen ? "active" : "")" @onclick="() => Slip.ToggleOpen()">
        <svg viewBox="0 0 24 24"><path d="M3 8a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2 2 0 0 0 0 4v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a2 2 0 0 0 0-4z"/></svg>
        <span>Bet Slip</span>
        @if (Slip.Legs.Count > 0)
        {
            <span class="badge">@Slip.Legs.Count</span>
        }
    </button>

    <NavLink class="tab-item" href="mybets">
        <svg viewBox="0 0 24 24"><path d="M5 3h14a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zm2 5h10M7 12h10M7 16h6"/></svg>
        <span>My Bets</span>
    </NavLink>

    <NavLink class="tab-item" href="leaderboard">
        <svg viewBox="0 0 24 24"><path d="M7 4h10v5a5 5 0 0 1-10 0zM7 6H4v2a3 3 0 0 0 3 3M17 6h3v2a3 3 0 0 1-3 3M8 21h8M12 17v4"/></svg>
        <span>Leaderboard</span>
    </NavLink>

    @if (AuthState.IsLoggedIn)
    {
        <NavLink class="tab-item" href="profile">
            <svg viewBox="0 0 24 24"><path d="M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065z" /><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" /></svg>
            <span>Settings</span>
        </NavLink>
    }
    else
    {
        <NavLink class="tab-item" href="login">
            <svg viewBox="0 0 24 24"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21a8 8 0 0 1 16 0"/></svg>
            <span>Login</span>
        </NavLink>
    }
</nav>

@code {
    protected override void OnInitialized()
    {
        AuthState.Changed += StateHasChanged;
        Slip.Changed += StateHasChanged;
    }

    public void Dispose()
    {
        AuthState.Changed -= StateHasChanged;
        Slip.Changed -= StateHasChanged;
    }
}
