@using System.Globalization
@inherits LayoutComponentBase
@implements IDisposable
@inject AuthState AuthState
@inject IPushRegistrar PushRegistrar
@inject IAdsRemovalService AdsRemoval
@inject IInterstitialAdService InterstitialAds
@inject ILocaleProvider LocaleProvider
@inject ICelebratedWinStore CelebratedWinStore
@inject ActiveContextState ContextState
@inject ApiClient Api
@inject NavigationManager Nav

@if (_showAppSplash)
{
    @* No logo here on purpose - the native launch screen already shows one (splash.svg), and a
       second independently-sized rendering of the same logo is exactly what caused it to visibly
       jump size at the handoff before. This is just a plain, same-colour bridge so the transition
       from native to real content reads as one continuous moment. *@
    <div class="app-splash @(_appSplashHiding ? "hiding" : "")"></div>
}

<div class="top-bar">
    <a class="brand-logo" href="">
        <img class="brand-crest" src="_content/FullTime.App.Shared/logo.png" alt="FullTime" width="56" height="56" />
        <span class="wordmark"><span class="full">FULL</span><span class="dot">&bull;</span><span class="time">TIME</span></span>
    </a>
    <ContextSwitcher />
</div>

<main class="content">
    @* @key forces a new DOM node per route so the fade-in CSS animation replays on every tab
       switch instead of only on first render. *@
    <div class="page-transition" @key="Nav.Uri">
        @Body
    </div>
</main>

<BetSlipSheet />
<ContextSwitcherSheet />
<BottomTabBar />
<WinCelebrationOverlay Bet="_celebrationBet" CurrencySymbol="@ContextState.CurrencySymbol" OnDismiss="DismissCelebration" />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private BetDto? _celebrationBet;
    private bool _showAppSplash = true;
    private bool _appSplashHiding;
    // Created eagerly (before OnInitialized/OnAfterRender run) so ShowStartupAdThenMaybeCelebrateAsync
    // can safely await it regardless of which of those two fires first - no race on a field that'd
    // otherwise only get assigned once rendering actually happens.
    private readonly TaskCompletionSource _splashDismissed = new();

    protected override void OnInitialized()
    {
        // Deliberately synchronous, with everything below fire-and-forget - this method running
        // for even a second or two before returning was a real cause of a "blank screen before the
        // splash appears" gap. BlazorWebView doesn't paint anything, including the splash, until
        // initialization completes, so awaiting push registration/ads-removal/an ad network round
        // trip here was delaying the very first paint by however long those happened to take.
        AuthState.Changed += OnAuthChanged;
        if (AuthState.IsLoggedIn)
        {
            _ = PushRegistrar.RegisterAsync();
            _ = SetCountryFromLocaleIfUnsetAsync();
        }

        _ = ShowStartupAdThenMaybeCelebrateAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Deliberately started here, not in OnInitialized - a Task.Delay started before the first
        // render ticks down regardless of whether the splash is visible yet. Starting it only once
        // this component has genuinely rendered guarantees the hold time is actually seen.
        _ = DismissAppSplashAsync();
    }

    private async Task DismissAppSplashAsync()
    {
        // Branding duration is now carried by the native launch screen (splash.svg has the logo
        // again) - this in-app overlay is just a brief bridge so the handoff from native to real
        // content reads as one continuous moment instead of an abrupt cut, not a second deliberate
        // wait stacked on top of however long the native/WebView boot phase already took.
        await Task.Delay(TimeSpan.FromMilliseconds(300));
        _appSplashHiding = true;
        await InvokeAsync(StateHasChanged);

        await Task.Delay(TimeSpan.FromMilliseconds(200));
        _showAppSplash = false;
        await InvokeAsync(StateHasChanged);
        _splashDismissed.TrySetResult();
    }

    private async Task ShowStartupAdThenMaybeCelebrateAsync()
    {
        await AdsRemoval.InitializeAsync();

        // The test ad in particular can load and show almost instantly - without this, it was
        // covering the splash before it was ever actually seen, which looked identical to the
        // splash itself being broken/too-brief from the outside.
        await _splashDismissed.Task;

        await InterstitialAds.ShowOnStartupAsync();

        if (!AuthState.IsLoggedIn)
        {
            return;
        }

        try
        {
            var bets = await Api.GetMyBetsAsync();
            var lastCelebratedRaw = await CelebratedWinStore.GetAsync();

            if (string.IsNullOrEmpty(lastCelebratedRaw))
            {
                // First time this device has ever checked - establish a baseline instead of
                // replaying the account's entire win history at once (e.g. an existing user
                // updating to this app version for the first time). Only wins settled from here
                // on get celebrated.
                await CelebratedWinStore.SetAsync(DateTime.UtcNow.ToString("O"));
                return;
            }

            var lastCelebratedAt = DateTime.Parse(lastCelebratedRaw, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind);

            // Every win settled since the last time this device celebrated one - not just the
            // most recent - so a busy matchday's worth of wins each get their own card instead
            // of only the latest one showing.
            var newWins = bets
                .Where(b => b.Status == "Won" && b.SettledAt is not null && b.SettledAt > lastCelebratedAt)
                .OrderBy(b => b.SettledAt)
                .ToList();

            if (newWins.Count == 0)
            {
                return;
            }

            await ContextState.InitializeAsync();

            foreach (var win in newWins)
            {
                // Marked as celebrated before it's shown, not after - so if the app gets closed
                // mid-queue, whichever cards already appeared don't replay next launch.
                await CelebratedWinStore.SetAsync(win.SettledAt!.Value.ToString("O"));
                _celebrationBet = win;
                await InvokeAsync(StateHasChanged);

                await Task.Delay(TimeSpan.FromSeconds(4));
                await InvokeAsync(DismissCelebration);

                // Brief gap so consecutive wins read as separate cards, not one flickering one.
                await Task.Delay(TimeSpan.FromMilliseconds(400));
            }
        }
        catch
        {
            // Best-effort, same reasoning as SetCountryFromLocaleIfUnsetAsync below - a missed
            // celebration on this particular launch isn't worth surfacing an error for.
        }
    }

    private void DismissCelebration()
    {
        _celebrationBet = null;
        StateHasChanged();
    }

    private void OnAuthChanged()
    {
        if (AuthState.IsLoggedIn)
        {
            _ = PushRegistrar.RegisterAsync();
            _ = SetCountryFromLocaleIfUnsetAsync();
        }
    }

    // No picker — the user's currency symbol is meant to just work, detected from their device/
    // browser locale the first time they're seen with no Country set. Best-effort: a failed detection
    // or save just leaves Country null for now (falls back to £ everywhere), retried next time
    // AuthState changes or the app cold-starts, rather than surfacing an error for a cosmetic detail.
    private async Task SetCountryFromLocaleIfUnsetAsync()
    {
        try
        {
            var me = await Api.GetMeAsync();
            if (me.Country is not null)
            {
                return;
            }

            var countryCode = await LocaleProvider.GetCountryCodeAsync();
            if (countryCode is not null)
            {
                await Api.UpdateProfileAsync(me.Name, countryCode);
            }
        }
        catch
        {
            // best-effort, see comment above
        }
    }

    public void Dispose() => AuthState.Changed -= OnAuthChanged;
}
