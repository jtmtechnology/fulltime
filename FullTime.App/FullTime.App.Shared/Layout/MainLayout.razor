@inherits LayoutComponentBase
@implements IDisposable
@inject AuthState AuthState
@inject IPushRegistrar PushRegistrar
@inject NavigationManager Nav

<div class="top-bar">
    <a class="brand-logo" href="">
        <svg class="brand-crest" viewBox="0 0 40 44" fill="none" aria-hidden="true">
            <defs>
                <linearGradient id="crestGrad" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#39ff88" />
                    <stop offset="1" stop-color="#0f6b3a" />
                </linearGradient>
            </defs>
            <path d="M20 2 37 9v13c0 12-8.5 18-17 20C11.5 40 3 34 3 22V9z" fill="url(#crestGrad)" stroke="#ffb020" stroke-width="1.6" />
            <rect x="13" y="15" width="14" height="11" fill="none" stroke="#f4f7fa" stroke-width="1.6" />
            <line x1="20" y1="15" x2="20" y2="26" stroke="#f4f7fa" stroke-width="1.1" opacity="0.75" />
            <circle cx="20" cy="31" r="1.8" fill="#f4f7fa" />
        </svg>
        <span class="wordmark"><span class="full">FULL</span><span class="dot">&bull;</span><span class="time">TIME</span></span>
    </a>
    <ContextSwitcher />
</div>

<main class="content">
    @* @key forces a new DOM node per route so the fade-in CSS animation replays on every tab
       switch instead of only on first render. *@
    <div class="page-transition" @key="Nav.Uri">
        @Body
    </div>
</main>

<BetSlipSheet />
<ContextSwitcherSheet />
<BottomTabBar />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        AuthState.Changed += OnAuthChanged;
        if (AuthState.IsLoggedIn)
        {
            await PushRegistrar.RegisterAsync();
        }
    }

    private void OnAuthChanged()
    {
        if (AuthState.IsLoggedIn)
        {
            _ = PushRegistrar.RegisterAsync();
        }
    }

    public void Dispose() => AuthState.Changed -= OnAuthChanged;
}
