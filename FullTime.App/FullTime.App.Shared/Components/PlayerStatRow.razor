@* One row in the Match Summary sheet's Player Stats tab - a compact table (shots/on target/cards/
   rating only, not the full stat line this used to show) sitting under MatchSummarySheet's own
   column-header row. Only players who actually appeared (Games.Minutes > 0, filtered server-side)
   ever reach this component. *@
<div class="player-stats-row">
    <span class="player-stats-name">
        <LogoImg Src="@Player.PhotoUrl" Alt="@Player.Name" CssClass="player-stats-photo" />
        <span class="player-stats-name-text">@Player.Name</span>
    </span>
    <span class="player-stats-stat">@(Player.ShotsTotal > 0 ? Player.ShotsTotal.ToString() : "-")</span>
    <span class="player-stats-stat">@(Player.ShotsTotal > 0 ? Player.ShotsOnTarget.ToString() : "-")</span>
    <span class="player-stats-stat player-stats-cards">
        @if (Player.YellowCards > 0)
        {
            <span>🟨</span>
        }
        @if (Player.RedCards > 0)
        {
            <span>🟥</span>
        }
    </span>
    @if (Player.Rating is { } rating)
    {
        <span class="player-stats-stat player-stats-rating @RatingClass(rating)">@rating</span>
    }
    else
    {
        <span class="player-stats-stat">-</span>
    }
</div>

@code {
    [Parameter, EditorRequired] public PlayerStatRowDto Player { get; set; } = default!;

    // Loosely mirrors typical match-rating colour conventions (>=7.5 good, <6 poor) - a
    // non-numeric/missing rating (a player who came on too late to be rated yet) falls back to the
    // neutral shade rather than guessing.
    private static string RatingClass(string rating) =>
        double.TryParse(rating, out var r)
            ? r switch { >= 7.5 => "rating-high", < 6 => "rating-low", _ => "rating-mid" }
            : "rating-mid";
}
