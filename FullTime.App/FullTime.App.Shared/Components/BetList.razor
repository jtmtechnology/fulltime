@* Shared bet-card/leg/pick rendering - used by MyBets.razor and Leaderboard.razor's "tap a name"
   friend-bets panel, so the two views can't drift on how a pick reads (same reasoning BetDisplay.cs
   already documents). *@

<div class="bet-list">
    @foreach (var bet in Bets)
    {
        <div class="bet-card">
            <div>
                <span class="context-badge">@(bet.LeagueName ?? "Worldwide")</span>
                <strong>@bet.PlacedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong> —
                Stake @CurrencySymbol@bet.Stake.ToString("0.00") ·
                Combined odds @bet.CombinedOdds.ToString("0.00") ·
                Potential return @CurrencySymbol@bet.PotentialReturn.ToString("0.00") ·
                <span class="@BetDisplay.StatusClass(bet.Status)">@bet.Status</span>
                @if (bet.BoostApplied is not null)
                {
                    <span class="live"> · 🚀 @bet.BoostApplied applied</span>
                }
            </div>
            <ul>
                @foreach (var leg in bet.Legs)
                {
                    <li>
                        <div class="bet-leg-header">
                            <span class="muted">@leg.KickoffTime.ToLocalTime().ToString("ddd d MMM HH:mm")</span> —
                            <LogoImg Src="@leg.HomeLogoUrl" CssClass="team-logo" Alt="@leg.HomeTeam" />@leg.HomeTeam
                            @if (HasScore(leg))
                            {
                                <strong class="bet-leg-score">@leg.HomeScore - @leg.AwayScore</strong>
                            }
                            else
                            {
                                <text> v </text>
                            }
                            <LogoImg Src="@leg.AwayLogoUrl" CssClass="team-logo" Alt="@leg.AwayTeam" />@leg.AwayTeam
                            @if (leg.MatchStatus == "InProgress")
                            {
                                <span class="live-clock bet-leg-status">Live</span>
                            }
                            else if (leg.MatchStatus == "Finished")
                            {
                                <span class="live-clock finished bet-leg-status">@MatchDisplay.FinishedLabel(leg.WentToExtraTime)</span>
                                @if (MatchDisplay.PenaltyScoreText(leg.HomePenalties, leg.AwayPenalties) is { } pens)
                                {
                                    <span class="live-clock finished bet-leg-status">(@pens)</span>
                                }
                            }
                            else if (leg.MatchStatus == "Postponed")
                            {
                                <span class="live-clock postponed bet-leg-status">Postponed</span>
                            }
                        </div>
                        <ul class="bet-leg-picks">
                            @foreach (var pick in leg.Picks)
                            {
                                <li class="@BetDisplay.StatusClass(pick.Outcome)">
                                    @BetDisplay.PickLabel(pick, leg.HomeTeam, leg.AwayTeam) (@pick.Outcome)
                                    @if (pick.PaidOutEarly)
                                    {
                                        <span class="early-payout-tag">⚡ Early payout</span>
                                    }
                                </li>
                            }
                        </ul>
                    </li>
                }
            </ul>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public List<BetDto> Bets { get; set; } = [];
    [Parameter] public string CurrencySymbol { get; set; } = "£";

    private static bool HasScore(BetLegDto leg) =>
        leg.MatchStatus is "InProgress" or "Finished" && leg.HomeScore is not null && leg.AwayScore is not null;
}
