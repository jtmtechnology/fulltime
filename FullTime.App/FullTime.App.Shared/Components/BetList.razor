@* Shared bet-card/leg/pick rendering - used by MyBets.razor and Leaderboard.razor's "tap a name"
   friend-bets panel, so the two views can't drift on how a pick reads (same reasoning BetDisplay.cs
   already documents). *@

<div class="bet-list">
    @foreach (var bet in Bets)
    {
        <div class="bet-card bet-card-@bet.Status.ToLowerInvariant()">
            <div class="bet-card-top">
                <span class="context-badge">@(bet.LeagueName ?? "Worldwide")</span>
                <span class="bet-status-pill bet-status-@bet.Status.ToLowerInvariant()">@bet.Status</span>
            </div>
            <div class="bet-card-meta muted">
                @BetTypeLabel(bet) · @bet.PlacedAt.ToLocalTime().ToString("d MMM, HH:mm")
                @if (bet.BoostApplied is not null)
                {
                    <span class="live"> · 🚀 @bet.BoostApplied</span>
                }
            </div>

            <div class="bet-card-totals">
                <div>
                    <span class="bet-total-label">Stake</span>
                    <span class="bet-total-value">@CurrencySymbol@bet.Stake.ToString("0.00")</span>
                </div>
                <div>
                    <span class="bet-total-label">Combined odds</span>
                    @* Decimal, not FormatOdds: its nearest-simple-ratio rounding turned a boosted 5.10
                       into "4/1", which doesn't multiply out to the return shown below it. *@
                    <span class="bet-total-value">@bet.CombinedOdds.ToString("0.00")</span>
                </div>
                <div>
                    <span class="bet-total-label">@ReturnLabel(bet.Status)</span>
                    <span class="bet-total-value @ReturnClass(bet.Status)">@CurrencySymbol@ReturnAmount(bet).ToString("0.00")</span>
                </div>
            </div>

            <div class="bet-legs">
                @foreach (var leg in bet.Legs)
                {
                    <div class="bet-leg">
                        <div class="bet-leg-meta">
                            <span class="muted">@leg.KickoffTime.ToLocalTime().ToString("ddd d MMM, HH:mm")</span>
                            @if (leg.MatchStatus == "InProgress")
                            {
                                <span class="live-clock">Live</span>
                            }
                            else if (leg.MatchStatus == "Finished")
                            {
                                <span class="live-clock finished">
                                    @MatchDisplay.FinishedLabel(leg.WentToExtraTime)
                                    @if (MatchDisplay.PenaltyScoreText(leg.HomePenalties, leg.AwayPenalties) is { } pens)
                                    {
                                        <text> (@pens)</text>
                                    }
                                </span>
                            }
                            else if (leg.MatchStatus is "Postponed" or "Abandoned")
                            {
                                <span class="live-clock postponed">@leg.MatchStatus</span>
                            }
                        </div>
                        <div class="bet-leg-team">
                            <LogoImg Src="@leg.HomeLogoUrl" CssClass="team-logo" Alt="@leg.HomeTeam" />
                            <span class="bet-leg-team-name">@leg.HomeTeam</span>
                            @if (HasScore(leg))
                            {
                                <strong class="bet-leg-score">@leg.HomeScore</strong>
                            }
                        </div>
                        <div class="bet-leg-team">
                            <LogoImg Src="@leg.AwayLogoUrl" CssClass="team-logo" Alt="@leg.AwayTeam" />
                            <span class="bet-leg-team-name">@leg.AwayTeam</span>
                            @if (HasScore(leg))
                            {
                                <strong class="bet-leg-score">@leg.AwayScore</strong>
                            }
                        </div>

                        @* A Bet Builder leg is priced as a whole (correlated picks), not as the product
                           of its picks, so its odds belong on the leg rather than on each pick. Skipped
                           when it's the bet's only leg - the totals row already shows the same price. *@
                        @if (leg.Picks.Count > 1 && bet.Legs.Count > 1)
                        {
                            <div class="bet-pick bet-pick-group muted">
                                <span class="bet-pick-label">Bet Builder</span>
                                <span class="bet-pick-odds">@OddsCell.FormatOdds(leg.OddsAtPlacement)</span>
                            </div>
                        }
                        @foreach (var pick in leg.Picks)
                        {
                            <div class="bet-pick">
                                <span class="bet-pick-icon bet-pick-@pick.Outcome.ToLowerInvariant()">@OutcomeIcon(pick.Outcome)</span>
                                <span class="bet-pick-label @BetDisplay.StatusClass(pick.Outcome)">
                                    @BetDisplay.PickLabel(pick, leg.HomeTeam, leg.AwayTeam)
                                    @if (pick.PaidOutEarly)
                                    {
                                        <span class="early-payout-tag">⚡ Early payout</span>
                                    }
                                </span>
                                @if (leg.Picks.Count == 1)
                                {
                                    <span class="bet-pick-odds">@OddsCell.FormatOdds(pick.OddsAtPlacement)</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public List<BetDto> Bets { get; set; } = [];
    [Parameter] public string CurrencySymbol { get; set; } = "£";

    private static bool HasScore(BetLegDto leg) =>
        leg.MatchStatus is "InProgress" or "Finished" && leg.HomeScore is not null && leg.AwayScore is not null;

    private static string BetTypeLabel(BetDto bet) => bet.Legs.Count switch
    {
        1 when bet.Legs[0].Picks.Count > 1 => "Bet Builder",
        1 => "Single",
        2 => "Double",
        3 => "Treble",
        var n => $"{n}-fold acca",
    };

    private static string OutcomeIcon(string outcome) => outcome switch
    {
        "Correct" => "✓",
        "Incorrect" => "✕",
        "Void" => "–",
        _ => "",
    };

    private static string ReturnLabel(string status) => status switch
    {
        "Won" => "Returned",
        "Void" => "Refunded",
        _ => "Potential return",
    };

    // A void bet hands back the stake, not PotentialReturn - showing the latter would read as a win.
    private static decimal ReturnAmount(BetDto bet) => bet.Status == "Void" ? bet.Stake : bet.PotentialReturn;

    private static string ReturnClass(string status) => status switch
    {
        "Won" => "live",
        "Lost" => "bet-total-lost",
        _ => "",
    };
}
