@implements IDisposable
@using System.Net
@inject BetSlipState Slip
@inject AuthState AuthState
@inject ActiveContextState ContextState
@inject ApiClient Api
@inject NavigationManager Nav
@inject IInterstitialAdService InterstitialAds
@inject IHapticFeedback Haptics

@if (Slip.Legs.Count > 0 || Slip.IsOpen)
{
    @if (!Slip.IsOpen)
    {
        <button type="button" class="slip-fab" @onclick="() => Slip.SetOpen(true)">
            <span>@Slip.Legs.Count selection@(Slip.Legs.Count == 1 ? "" : "s")</span>
            <span>@Slip.CombinedOdds.ToString("0.00")</span>
        </button>
    }
    else
    {
        <button type="button" class="slip-overlay" @onclick="() => Slip.SetOpen(false)" aria-label="Close bet slip"></button>
        <div class="slip-sheet">
            <div class="sheet-handle"></div>

            @if (_justPlaced)
            {
                <div class="bet-success">
                    <div class="bet-success-check">✓</div>
                    <h2>Bet placed!</h2>
                    <p class="bet-success-return">Potential return: @ContextState.CurrencySymbol@_placedReturn.ToString("0.00")</p>
                    @if (_placedBoostLabel is not null)
                    {
                        <p class="bet-success-boost">🚀 @_placedBoostLabel applied!</p>
                    }
                    else if (_placedBoostSkippedReason is not null)
                    {
                        <p class="bet-success-boost">🎁 @_placedBoostSkippedReason</p>
                    }
                </div>
            }
            else
            {
                <h2>Bet slip</h2>

                @if (Slip.Legs.Count == 0)
                {
                    <div class="muted">No selections yet — tap an odds pill to add one.</div>
                }
                else
                {
                    <ul>
                        @foreach (var entry in Slip.Legs)
                        {
                            var matchId = entry.Key;
                            var leg = entry.Value;
                            <li>
                                <span>@leg.HomeTeam v @leg.AwayTeam — @string.Join(" + ", leg.Picks.Select(p => PickLabel(p, leg.HomeTeam, leg.AwayTeam))) (@OddsCell.FormatOdds(leg.CombinedOdds))</span>
                                <button type="button" class="remove-btn" title="Remove" @onclick="() => RemoveSelectionAsync(matchId)">×</button>
                            </li>
                        }
                    </ul>
                    <div>Combined odds: <strong>@Slip.CombinedOdds.ToString("0.00")</strong></div>
                    <div class="field">
                        <label for="slip-stake">Stake (@ContextState.CurrencySymbol)</label>
                        <input type="number" id="slip-stake" min="0.01" step="0.01" @bind="_stake" @bind:event="oninput" />
                    </div>
                    <div>
                        Potential return: <strong>@ContextState.CurrencySymbol@BoostedPotentialReturn.ToString("0.00")</strong>
                        @if (PendingBoostQualifies)
                        {
                            <span class="live"> (🚀 @_pendingBoostLabel applied)</span>
                        }
                        else if (BetBuilderBoostQualifies)
                        {
                            <span class="live"> (🚀 Bet Builder Boost @_bbBoostStatus!.Percent.ToString("0.##")% applied)</span>
                        }
                    </div>

                    @if (_pendingBoostLabel is not null && !PendingBoostQualifies)
                    {
                        <div class="muted">
                            🎁 Your @_pendingBoostLabel needs combined odds of Evens (2.00) or higher to apply —
                            it'll carry over to a future bet that qualifies.
                        </div>
                    }

                    @if (!AuthState.IsLoggedIn)
                    {
                        <div class="muted"><a href="login">Log in</a> to place this bet.</div>
                    }
                    else if (ContextState.Current.LeagueId is null)
                    {
                        <div class="muted">Join or create a league on the Leaderboard tab before placing a bet.</div>
                    }
                    else if (BetBuilderBoostActiveForSlip && !BetBuilderBoostQualifies)
                    {
                        <div class="muted">🚀 @BetBuilderBoostGateMessage</div>
                    }
                    else
                    {
                        <div class="muted">
                            Betting in: <strong>@ContextState.Current.Name</strong>
                            @if (ContextState.Balance is not null)
                            {
                                <text> — Balance: @ContextState.CurrencySymbol@ContextState.Balance.Value.ToString("0.00")</text>
                            }
                        </div>
                        <button type="button" class="place-bet-btn" @onclick="PlaceBetAsync" disabled="@_placing">Place bet</button>
                    }
                }

                @if (!string.IsNullOrEmpty(_slipStatus))
                {
                    <div class="status @(_slipError ? "error" : "")">@_slipStatus</div>
                }
            }
        </div>
    }
}

@code {
    private decimal _stake = 10;
    private bool _placing;
    private string _slipStatus = "";
    private bool _slipError;
    private bool _wasOpen;
    private bool _justPlaced;
    private decimal _placedReturn;
    private string? _placedBoostLabel;
    private string? _placedBoostSkippedReason;
    private decimal? _pendingBoostMultiplier;
    private string? _pendingBoostLabel;
    private BetBuilderBoostStatusDto? _bbBoostStatus;

    // Same evens-or-greater rule as the Bet Builder Boost - a pending Daily Spinner boost
    // (BetBoost25/50, 2x Odds Boost) only ever applies to a bet whose combined odds already clear
    // Evens, otherwise it's left pending server-side rather than wasted (see BetService.PlaceBetAsync).
    private bool PendingBoostQualifies => _pendingBoostMultiplier is not null && Slip.CombinedOdds >= 2m;

    // Only "just this match's Bet Builder" bets are eligible - a slip with any other leg mixed in
    // (or more than one leg) isn't the featured match's own same-game multi any more, so the
    // evens-gate/boost preview both stand down and the bet places completely normally.
    // ViaBoost is only ever true if this leg was built on a Bet Builder visit reached through the
    // boost banner itself (see BetBuilder.razor's "boost" query param) - reaching the same match's
    // Bet Builder any other way must never apply the boost or show its rules.
    private bool BetBuilderBoostActiveForSlip =>
        _bbBoostStatus is { Available: true } status
        && Slip.Legs.Count == 1
        && Slip.Legs.Keys.First() == status.MatchId
        && Slip.Legs.Values.First().ViaBoost;

    // bet365's own "Boost your Bet Builder" terms: 3+ selections AND combined odds of evens or
    // greater - both required, not either/or.
    private bool BetBuilderBoostQualifies =>
        BetBuilderBoostActiveForSlip
        && Slip.Legs.Values.First().Picks.Count >= _bbBoostStatus!.MinSelections
        && Slip.CombinedOdds > 2m;

    private decimal EffectiveBoostMultiplier =>
        PendingBoostQualifies ? _pendingBoostMultiplier!.Value
        : BetBuilderBoostQualifies ? 1m + _bbBoostStatus!.Percent / 100m
        : 1m;

    // Names whichever of the two bet365-style requirements (3+ selections, combined odds over
    // Evens) this slip is still short of, rather than always repeating both regardless of which one
    // is actually the blocker.
    private string BetBuilderBoostGateMessage
    {
        get
        {
            var status = _bbBoostStatus!;
            var picksShort = status.MinSelections - Slip.Legs.Values.First().Picks.Count;
            var needsOdds = Slip.CombinedOdds <= 2m;

            var requirement = (picksShort > 0, needsOdds) switch
            {
                (true, true) => $"needs {status.MinSelections}+ selections and combined odds over Evens (2.00)",
                (true, false) => $"needs {status.MinSelections}+ selections ({picksShort} more)",
                (false, true) => "needs combined odds over Evens (2.00) — add another selection",
                _ => "already qualifies",
            };
            return $"This match's Bet Builder Boost {requirement} for +{status.Percent:0.##}%.";
        }
    }

    private decimal BoostedPotentialReturn => _stake * Slip.CombinedOdds * EffectiveBoostMultiplier;

    protected override async Task OnInitializedAsync()
    {
        await Slip.InitializeAsync();
        Slip.Changed += OnSlipChanged;
        AuthState.Changed += OnAuthChanged;
        ContextState.Changed += OnContextChanged;

        if (AuthState.IsLoggedIn)
        {
            await ContextState.InitializeAsync();
        }
    }

    // On the Web host this first pass runs during static prerendering, before JS interop
    // (Slip's storage) is available — re-run once interactive, same pattern as Routes.razor.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Slip.InitializeAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnSlipChanged()
    {
        // _slipStatus is transient feedback from the last placement attempt — without this, opening
        // the sheet again later (to place a brand new bet) would still show "Bet placed!" from a
        // previous, unrelated bet.
        if (Slip.IsOpen && !_wasOpen)
        {
            _slipStatus = "";
            _slipError = false;
            _justPlaced = false;

            if (AuthState.IsLoggedIn)
            {
                _ = RefreshPendingBoostAsync();
            }
        }

        _wasOpen = Slip.IsOpen;
        InvokeAsync(StateHasChanged);
    }

    // Refreshed each time the sheet opens (rather than once at page load) so a boost won on the
    // Daily Spinner in the meantime shows up here without needing a full app restart.
    private async Task RefreshPendingBoostAsync()
    {
        try
        {
            var status = await Api.GetSpinStatusAsync();
            _pendingBoostMultiplier = status.PendingBoostMultiplier;
            _pendingBoostLabel = status.PendingBoostLabel;
        }
        catch (ApiException)
        {
            // best-effort - the slip just won't preview the boost if this fails, still applies
            // correctly server-side at placement either way
        }

        try
        {
            _bbBoostStatus = await Api.GetBetBuilderBoostStatusAsync();
        }
        catch (ApiException)
        {
            // best-effort - same as above; the evens gate/preview just won't show, but the actual
            // boost eligibility is re-checked from scratch server-side at placement regardless.
        }

        await InvokeAsync(StateHasChanged);
    }

    private void OnContextChanged() => InvokeAsync(StateHasChanged);

    private void OnAuthChanged() => InvokeAsync(async () =>
    {
        if (AuthState.IsLoggedIn)
        {
            await ContextState.InitializeAsync();
        }
        StateHasChanged();
    });

    private async Task RemoveSelectionAsync(Guid matchId) => await Slip.RemoveAsync(matchId);

    private static string PickLabel(SlipPick pick, string homeTeam, string awayTeam) => pick.MarketType switch
    {
        "MatchResult" => pick.Side switch { "Home" => "Home win", "Away" => "Away win", _ => "Draw" },
        "OverUnder" => $"{pick.Side} {pick.Line:0.##} goals",
        "TotalCorners" => $"{pick.Side} {pick.Line:0.##} corners",
        "TeamCorners" => $"{TeamName(pick.Team, homeTeam, awayTeam)} {pick.Side} {pick.Line:0.##} corners",
        "TeamCards" => $"{TeamName(pick.Team, homeTeam, awayTeam)} {pick.Side} {pick.Line:0.##} cards",
        "BothTeamsToScore" => pick.Side == "Yes" ? "BTTS Yes" : "BTTS No",
        "CorrectScore" => $"{pick.PredictedHomeScore} - {pick.PredictedAwayScore}",
        "FirstTeamToScore" => $"First to score: {pick.Side switch { "Home" => homeTeam, "Away" => awayTeam, _ => "None" }}",
        "PlayerGoalscorerAnytime" => $"{pick.PlayerName} to score anytime",
        "PlayerCard" => $"{pick.PlayerName} to be booked",
        "PlayerRedCard" => $"{pick.PlayerName} to be sent off",
        "PlayerAssists" => $"{pick.PlayerName} {LinePlusLabel(pick.Line)} assists",
        "PlayerShotsOnTarget" => $"{pick.PlayerName} {LinePlusLabel(pick.Line)} shots on target",
        "PlayerShots" => $"{pick.PlayerName} {LinePlusLabel(pick.Line)} shots",
        "PlayerFoulsCommitted" => $"{pick.PlayerName} {LinePlusLabel(pick.Line)} fouls committed",
        _ => pick.Side ?? "",
    };

    // "Over 1.5" reads as "2+" - matches BetBuilder.razor's LineLabel convention for the same lined
    // player-prop markets (a half-line "Over 1.5" means 2 or more, shown as a whole number).
    private static string LinePlusLabel(decimal? line) => line is { } l ? $"{(int)(l + 1m)}+" : "";

    private static string TeamName(string? team, string homeTeam, string awayTeam) =>
        team switch { "Home" => homeTeam, "Away" => awayTeam, _ => team ?? "" };

    private async Task PlaceBetAsync()
    {
        if (_stake <= 0)
        {
            _slipStatus = "Enter a stake greater than zero.";
            _slipError = true;
            return;
        }

        _slipStatus = "Placing bet…";
        _slipError = false;
        _placing = true;

        try
        {
            var legs = Slip.Legs.Select(kv => new LegRequest(
                kv.Key, kv.Value.Picks.Select(p => new PickRequest(
                    p.MarketType, p.Line, p.Side, p.PredictedHomeScore, p.PredictedAwayScore, p.PlayerName, p.Team)).ToList())).ToList();
            var placedBet = await Api.PlaceBetAsync(_stake, legs, ContextState.Current.LeagueId, BetBuilderBoostActiveForSlip);

            await Slip.ClearAsync();
            await ContextState.RefreshBalanceAsync();

            // Hold the sheet open on a brief success view instead of closing instantly - gives the
            // placement a moment of its own instead of just silently vanishing. The interstitial ad
            // is deliberately triggered AFTER this finishes, not concurrently with it - MAUI's
            // BlazorWebView doesn't reliably resume its own pending renders once a native ad
            // Activity has taken the foreground and been dismissed, which left this view stuck
            // on-screen forever when the two overlapped.
            _placedReturn = placedBet.PotentialReturn;
            _placedBoostLabel = placedBet.BoostApplied;
            _placedBoostSkippedReason = placedBet.BoostSkippedReason;
            // Only actually consumed server-side when BoostSkippedReason is null (either applied, or
            // there was nothing pending) - a skipped boost (odds under Evens) stays pending server-side
            // for a future bet, so the local preview must keep showing it as pending too.
            if (placedBet.BoostSkippedReason is null)
            {
                _pendingBoostMultiplier = null;
                _pendingBoostLabel = null;
            }
            _justPlaced = true;
            Haptics.Tap();
            StateHasChanged();

            await Task.Delay(TimeSpan.FromMilliseconds(2400));
            _justPlaced = false;
            Slip.SetOpen(false);

            _ = InterstitialAds.ShowAfterBetPlacedAsync();
        }
        catch (ApiException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            await AuthState.LogoutAsync();
            Slip.SetOpen(false);
            Nav.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            _slipStatus = $"Error: {ex.Message}";
            _slipError = true;
        }
        finally
        {
            _placing = false;
        }
    }

    public void Dispose()
    {
        Slip.Changed -= OnSlipChanged;
        AuthState.Changed -= OnAuthChanged;
        ContextState.Changed -= OnContextChanged;
    }
}
