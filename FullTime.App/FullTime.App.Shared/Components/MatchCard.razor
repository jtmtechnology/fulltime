<div class="match-card">
    <div class="kickoff-row">
        @if (Match.Status == "InProgress")
        {
            <span class="live-dot"></span>
        }
        <span>@Match.KickoffTime.ToLocalTime().ToString("ddd d MMM, HH:mm")</span>
        <div class="kickoff-row-trailing">
            @if (Match.Status == "InProgress")
            {
                <span class="live-clock">@LiveClockText()</span>
            }
            else if (Match.Status == "Finished")
            {
                <span class="live-clock finished">@MatchDisplay.FinishedLabel(Match)</span>
                @if (MatchDisplay.PenaltyScoreText(Match) is { } pens)
                {
                    <span class="live-clock finished">(@pens)</span>
                }
            }
            else if (Match.Status == "Postponed")
            {
                <span class="live-clock postponed">Postponed</span>
            }
            @* Shown before and during a match - "notify me about this match" stops being
               meaningful once it's over or once it no longer has a real kickoff time, unlike
               Bet Builder/Match Details below. *@
            @if (Match.Status is not ("Finished" or "Postponed"))
            {
                <button type="button" class="alert-bell-btn @(AlertSubs.IsAlerted(Match) ? "active" : "")" @onclick="ToggleAlertAsync"
                        aria-label="@(AlertSubs.IsAlerted(Match) ? "Remove match alert" : "Add match alert")">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2Zm6-6.68V11c0-3.07-1.64-5.64-4.5-6.32V4a1.5 1.5 0 0 0-3 0v.68C7.64 5.36 6 7.92 6 11v4.32L4 17.32V18h16v-.68l-2-2Z" />
                    </svg>
                </button>
            }
        </div>
    </div>

    <div class="match-teams-row">
        <div class="match-team">
            <LogoImg Src="@Match.HomeLogoUrl" CssClass="crest" Alt="@Match.HomeTeam" />
            <span class="team-name">@Match.HomeTeam</span>
        </div>
        <div class="match-score @(Match.Status is "Upcoming" or "Postponed" ? "pending" : "")">@ScoreText()</div>
        <div class="match-team">
            <LogoImg Src="@Match.AwayLogoUrl" CssClass="crest" Alt="@Match.AwayTeam" />
            <span class="team-name">@Match.AwayTeam</span>
        </div>
    </div>

    @if (Match.Status == "Upcoming" && HasOdds)
    {
        <div class="odds-row">
            <OddsCell MatchId="@Match.Id" MatchStatus="@Match.Status" Pick="Home" Odds="@Match.HomeOdds"
                      HomeTeam="@Match.HomeTeam" AwayTeam="@Match.AwayTeam" KickoffTime="@Match.KickoffTime" />
            <OddsCell MatchId="@Match.Id" MatchStatus="@Match.Status" Pick="Draw" Odds="@Match.DrawOdds"
                      HomeTeam="@Match.HomeTeam" AwayTeam="@Match.AwayTeam" KickoffTime="@Match.KickoffTime" />
            <OddsCell MatchId="@Match.Id" MatchStatus="@Match.Status" Pick="Away" Odds="@Match.AwayOdds"
                      HomeTeam="@Match.HomeTeam" AwayTeam="@Match.AwayTeam" KickoffTime="@Match.KickoffTime" />
        </div>
    }

    <div class="bookmaker-row">
        @if (Match.Status == "Upcoming" && HasOdds)
        {
            <BookmakerLogo Name="@Match.Bookmaker" LogoUrl="@Match.BookmakerLogoUrl" />
        }
        @if (Match.Status == "Upcoming" && Match.BetBuilderAvailable)
        {
            <a class="bet-builder-link" href="@BetBuilderHref()">Bet Builder</a>
        }
        @* Independent of the Bet Builder link above (not else-if) - once lineups are announced,
           typically ~1h before kickoff, Match Details is worth showing alongside Bet Builder, not
           only after the match has actually started/finished. Postponed is excluded regardless -
           there's nothing to show for a match that hasn't happened and has no fixed kickoff. *@
        @if (Match.Status != "Postponed" && (Match.EventsAvailable || Match.LineupsAvailable))
        {
            <button type="button" class="bet-builder-link" @onclick="() => Summary.Open(Match)">Match Details</button>
        }
    </div>
</div>

@implements IDisposable
@code {
    [Inject] private MatchSummaryState Summary { get; set; } = default!;
    [Inject] private MatchAlertSubscriptions AlertSubs { get; set; } = default!;

    [Parameter, EditorRequired] public UpcomingMatchDto Match { get; set; } = default!;

    // Set by the parent page (Matches.razor / LeagueMatches.razor) so Match Summary's back button
    // returns to wherever this card was shown, not always the main Matches list.
    [Parameter] public string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        AlertSubs.Changed += OnAlertSubsChanged;
        // Guarded internally (a no-op past the first call) - every card on a page calls this, but
        // only the first one actually triggers the one shared GET.
        await AlertSubs.InitializeAsync();
    }

    private void OnAlertSubsChanged() => InvokeAsync(StateHasChanged);

    private Task ToggleAlertAsync() => AlertSubs.ToggleAsync(Match);

    public void Dispose() => AlertSubs.Changed -= OnAlertSubsChanged;

    // No odds fetched yet for this match (e.g. too far out) - showing three "—" cells and a "—"
    // bookmaker placeholder reads as broken, not "coming soon", so hide the whole section instead.
    private bool HasOdds => Match.HomeOdds is not null || Match.DrawOdds is not null || Match.AwayOdds is not null;

    private string ScoreText() => Match.Status switch
    {
        "InProgress" or "Finished" => $"{Match.HomeScore} - {Match.AwayScore}",
        _ => "vs",
    };

    // Live match minute ("clock"), null before kickoff. Half time is a distinct flag rather than
    // inferred from the minute, since the clock alone can't tell "still 1st half, 45th minute"
    // apart from "paused at half time, sitting at 45". AddedTimeMinutes (API-Football only,
    // Highlightly has no equivalent) shows stoppage time as "90+3'" rather than capping at "90'".
    private string LiveClockText() => Match.IsHalfTime
        ? "HT"
        : Match.Minute is { } minute
            ? Match.AddedTimeMinutes is { } added && added > 0 ? $"{minute}+{added}'" : $"{minute}'"
            : "";

    private string BetBuilderHref() =>
        $"bet-builder/{Match.Id}?home={Uri.EscapeDataString(Match.HomeTeam)}&away={Uri.EscapeDataString(Match.AwayTeam)}" +
        $"&kickoff={Uri.EscapeDataString(Match.KickoffTime.ToString("O"))}&league={Uri.EscapeDataString(LeagueCatalog.Name(Match.LeagueId))}" +
        $"&homeLogo={Uri.EscapeDataString(Match.HomeLogoUrl ?? "")}&awayLogo={Uri.EscapeDataString(Match.AwayLogoUrl ?? "")}" +
        $"&return={Uri.EscapeDataString(ReturnUrl ?? "/")}";
}
