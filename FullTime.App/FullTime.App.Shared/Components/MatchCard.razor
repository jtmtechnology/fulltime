<div class="match-card">
    <div class="kickoff-row">
        @if (Match.Status == "InProgress")
        {
            <span class="live-dot"></span>
        }
        <span>@Match.KickoffTime.ToLocalTime().ToString("ddd d MMM, HH:mm")</span>
        @if (Match.Status == "InProgress")
        {
            <span class="live-clock">@LiveClockText()</span>
        }
        else if (Match.Status == "Finished")
        {
            <span class="live-clock finished">FT</span>
        }
    </div>

    <div class="match-teams-row">
        <div class="match-team">
            <LogoImg Src="@Match.HomeLogoUrl" CssClass="crest" Alt="@Match.HomeTeam" />
            <span class="team-name">@Match.HomeTeam</span>
        </div>
        <div class="match-score @(Match.Status == "Upcoming" ? "pending" : "")">@ScoreText()</div>
        <div class="match-team">
            <LogoImg Src="@Match.AwayLogoUrl" CssClass="crest" Alt="@Match.AwayTeam" />
            <span class="team-name">@Match.AwayTeam</span>
        </div>
    </div>

    @if (Match.Status == "Upcoming" && HasOdds)
    {
        <div class="odds-row">
            <OddsCell MatchId="@Match.Id" MatchStatus="@Match.Status" Pick="Home" Odds="@Match.HomeOdds"
                      HomeTeam="@Match.HomeTeam" AwayTeam="@Match.AwayTeam" KickoffTime="@Match.KickoffTime" />
            <OddsCell MatchId="@Match.Id" MatchStatus="@Match.Status" Pick="Draw" Odds="@Match.DrawOdds"
                      HomeTeam="@Match.HomeTeam" AwayTeam="@Match.AwayTeam" KickoffTime="@Match.KickoffTime" />
            <OddsCell MatchId="@Match.Id" MatchStatus="@Match.Status" Pick="Away" Odds="@Match.AwayOdds"
                      HomeTeam="@Match.HomeTeam" AwayTeam="@Match.AwayTeam" KickoffTime="@Match.KickoffTime" />
        </div>
    }

    <div class="bookmaker-row">
        @if (Match.Status == "Upcoming" && HasOdds)
        {
            <BookmakerLogo Name="@Match.Bookmaker" LogoUrl="@Match.BookmakerLogoUrl" />
        }
        @if (Match.Status == "Upcoming" && Match.BetBuilderAvailable)
        {
            <a class="bet-builder-link" href="@BetBuilderHref()">Bet Builder</a>
        }
        else if ((Match.Status == "Finished" || Match.Status == "InProgress") && Match.EventsAvailable)
        {
            <a class="bet-builder-link" href="@MatchEventsHref()">Match Summary</a>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public UpcomingMatchDto Match { get; set; } = default!;

    // No odds fetched yet for this match (e.g. too far out) - showing three "—" cells and a "—"
    // bookmaker placeholder reads as broken, not "coming soon", so hide the whole section instead.
    private bool HasOdds => Match.HomeOdds is not null || Match.DrawOdds is not null || Match.AwayOdds is not null;

    private string ScoreText() => Match.Status switch
    {
        "InProgress" or "Finished" => $"{Match.HomeScore} - {Match.AwayScore}",
        _ => "vs",
    };

    // Live match minute ("clock"), null before kickoff. Half time is a distinct flag rather than
    // inferred from the minute, since the clock alone can't tell "still 1st half, 45th minute"
    // apart from "paused at half time, sitting at 45". AddedTimeMinutes (API-Football only,
    // Highlightly has no equivalent) shows stoppage time as "90+3'" rather than capping at "90'".
    private string LiveClockText() => Match.IsHalfTime
        ? "HT"
        : Match.Minute is { } minute
            ? Match.AddedTimeMinutes is { } added && added > 0 ? $"{minute}+{added}'" : $"{minute}'"
            : "";

    private string BetBuilderHref() =>
        $"bet-builder/{Match.Id}?home={Uri.EscapeDataString(Match.HomeTeam)}&away={Uri.EscapeDataString(Match.AwayTeam)}" +
        $"&kickoff={Uri.EscapeDataString(Match.KickoffTime.ToString("O"))}&league={Uri.EscapeDataString(LeagueCatalog.Name(Match.LeagueId))}" +
        $"&homeLogo={Uri.EscapeDataString(Match.HomeLogoUrl ?? "")}&awayLogo={Uri.EscapeDataString(Match.AwayLogoUrl ?? "")}";

    private string MatchEventsHref() =>
        $"match-events/{Match.Id}?home={Uri.EscapeDataString(Match.HomeTeam)}&away={Uri.EscapeDataString(Match.AwayTeam)}" +
        $"&kickoff={Uri.EscapeDataString(Match.KickoffTime.ToString("O"))}" +
        $"&homeLogo={Uri.EscapeDataString(Match.HomeLogoUrl ?? "")}&awayLogo={Uri.EscapeDataString(Match.AwayLogoUrl ?? "")}" +
        $"&homeScore={Match.HomeScore}&awayScore={Match.AwayScore}" +
        $"&status={Uri.EscapeDataString(Match.Status)}&minute={Match.Minute}&addedTime={Match.AddedTimeMinutes}&isHalfTime={Match.IsHalfTime}";
}
