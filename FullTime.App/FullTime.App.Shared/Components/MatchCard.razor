<div class="match-card">
    <div class="kickoff-row">
        @if (Match.Status == "InProgress")
        {
            <span class="live-dot"></span>
        }
        <span>@Match.KickoffTime.ToLocalTime().ToString("ddd d MMM, HH:mm")</span>
    </div>

    <div class="match-teams-row">
        <div class="match-team">
            <LogoImg Src="@Match.HomeLogoUrl" CssClass="crest" Alt="@Match.HomeTeam" />
            <span class="team-name">@Match.HomeTeam</span>
        </div>
        <div class="match-score @(Match.Status == "Upcoming" ? "pending" : "")">@ScoreText()</div>
        <div class="match-team">
            <LogoImg Src="@Match.AwayLogoUrl" CssClass="crest" Alt="@Match.AwayTeam" />
            <span class="team-name">@Match.AwayTeam</span>
        </div>
    </div>

    <div class="odds-row">
        <OddsCell MatchId="@Match.Id" MatchStatus="@Match.Status" Pick="Home" Odds="@Match.HomeOdds"
                  HomeTeam="@Match.HomeTeam" AwayTeam="@Match.AwayTeam" KickoffTime="@Match.KickoffTime" />
        <OddsCell MatchId="@Match.Id" MatchStatus="@Match.Status" Pick="Draw" Odds="@Match.DrawOdds"
                  HomeTeam="@Match.HomeTeam" AwayTeam="@Match.AwayTeam" KickoffTime="@Match.KickoffTime" />
        <OddsCell MatchId="@Match.Id" MatchStatus="@Match.Status" Pick="Away" Odds="@Match.AwayOdds"
                  HomeTeam="@Match.HomeTeam" AwayTeam="@Match.AwayTeam" KickoffTime="@Match.KickoffTime" />
    </div>

    <div class="bookmaker-row">
        <BookmakerLogo Name="@Match.Bookmaker" LogoUrl="@Match.BookmakerLogoUrl" />
        @if (Match.Status == "Upcoming" && Match.BetBuilderAvailable)
        {
            <a class="bet-builder-link" href="@BetBuilderHref()">Bet Builder</a>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public UpcomingMatchDto Match { get; set; } = default!;

    private string ScoreText() => Match.Status switch
    {
        "InProgress" or "Finished" => $"{Match.HomeScore} - {Match.AwayScore}",
        _ => "vs",
    };

    private string BetBuilderHref() =>
        $"bet-builder/{Match.Id}?home={Uri.EscapeDataString(Match.HomeTeam)}&away={Uri.EscapeDataString(Match.AwayTeam)}&kickoff={Uri.EscapeDataString(Match.KickoffTime.ToString("O"))}";
}
