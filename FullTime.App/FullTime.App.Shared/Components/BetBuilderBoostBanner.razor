@inject NavigationManager Nav

@* Display-only - PromoCarousel fetches the status and decides whether this slide applies
   (available, and the match's league is one this user has opted into). *@
<button type="button" class="bbboost-banner" @onclick="Go">
    <div class="bbboost-banner-icon">🚀</div>
    <div class="bbboost-banner-text">
        <div class="bbboost-banner-title">BET BUILDER BOOST</div>
        <div class="bbboost-banner-match">@Status.HomeTeam v @Status.AwayTeam</div>
        <div class="bbboost-banner-pct">+@Status.Percent.ToString("0.##")% Odds Boost</div>
        <div class="bbboost-banner-terms">@Status.MinSelections+ selections, combined odds Evens or above</div>
    </div>
    <div class="bbboost-banner-arrow">›</div>
</button>

@code {
    [Parameter, EditorRequired] public BetBuilderBoostStatusDto Status { get; set; } = default!;

    // Same query params MatchCard.BetBuilderHref() sends for a normal match tap, plus boost=1 - the
    // owner reported blank team names/wrong kickoff/no crests on Bet Builder when reached from this
    // banner because it originally sent none of these, unlike every other entry point.
    private void Go() => Nav.NavigateTo(
        $"/bet-builder/{Status.MatchId}?boost=1&home={Uri.EscapeDataString(Status.HomeTeam ?? "")}&away={Uri.EscapeDataString(Status.AwayTeam ?? "")}" +
        $"&kickoff={Uri.EscapeDataString((Status.KickoffTime ?? DateTime.UtcNow).ToString("O"))}&league={Uri.EscapeDataString(LeagueCatalog.Name(Status.LeagueId ?? 0))}" +
        $"&homeLogo={Uri.EscapeDataString(Status.HomeLogoUrl ?? "")}&awayLogo={Uri.EscapeDataString(Status.AwayLogoUrl ?? "")}");
}
