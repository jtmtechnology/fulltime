@* One row in the match-events timeline (MatchEvents.razor) - home-team events align left, away-team
   events align right, matching how live-score apps typically lay this out. *@
<div class="match-event-row @(Event.Team == "Home" ? "home" : "away")">
    @if (Event.Team == "Away")
    {
        <span class="match-event-minute">@Event.Minute'</span>
    }
    <span class="match-event-icon">@Icon</span>
    <span class="match-event-text">@Text</span>
    @if (Event.Team == "Home")
    {
        <span class="match-event-minute">@Event.Minute'</span>
    }
</div>

@code {
    [Parameter, EditorRequired] public MatchEventDto Event { get; set; } = default!;

    private string Icon => Event.Type switch
    {
        "Goal" or "Penalty" or "Own Goal" or "VAR Goal Confirmed" => "⚽",
        "Missed Penalty" => "❌",
        "VAR Goal Cancelled" => "🚫",
        "VAR Penalty" => "📺",
        "Yellow Card" => "🟨",
        "Red Card" => "🟥",
        "Substitution" => "⇄",
        _ => "•",
    };

    // "Bryan Mbeumo (Kobbie Mainoo)" for a goal with an assist, "Jack Grealish (Brennan Johnson)" for
    // a substitution (player on, player off) - just the player name otherwise. Highlightly's full
    // event-type vocabulary isn't confirmed (see Models/MatchEvent.cs), so an unrecognized type still
    // falls back to showing its raw name rather than nothing.
    private string Text => Event.Type switch
    {
        "Goal" when Event.AssistPlayerName is { } assist => $"{Event.PlayerName} ({assist})",
        "Substitution" when Event.SubstitutedPlayerName is { } off => $"{Event.PlayerName} ({off})",
        "Penalty" => $"{Event.PlayerName} (Penalty)",
        "Missed Penalty" => $"{Event.PlayerName} (Penalty missed)",
        // The scorer here is on the opposing side to Event.Team (which carries the team credited
        // with the goal) - without this label it reads exactly like a normal goal for whichever
        // side Event.Team puts it on, with no indication the named player put it into their own net.
        "Own Goal" => $"{Event.PlayerName} (Own Goal)",
        "VAR Goal Cancelled" => $"{Event.PlayerName} (Disallowed)",
        _ => Event.PlayerName ?? Event.Type,
    };
}
