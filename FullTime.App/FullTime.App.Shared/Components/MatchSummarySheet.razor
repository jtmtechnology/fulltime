@implements IDisposable
@inject MatchSummaryState Summary
@inject ApiClient Api

@if (Summary is { IsOpen: true, Match: { } match })
{
    <div class="match-summary-sheet">
        <div class="page-header-row">
            <button type="button" class="back-btn" @onclick="Close" aria-label="Back">‹</button>
            <h1>Match Summary</h1>
        </div>

        <div class="bb-teams-row">
            <div class="bb-team">
                <LogoImg Src="@match.HomeLogoUrl" CssClass="crest" Alt="@match.HomeTeam" />
                <span>@match.HomeTeam</span>
            </div>
            <div class="bb-kickoff">
                <span class="match-events-score">@match.HomeScore - @match.AwayScore</span>
                <span class="muted">@match.KickoffTime.ToLocalTime().ToString("d MMM, HH:mm")</span>
                @if (MatchStatusText(match) is { } statusText)
                {
                    <span class="match-events-status @(match.Status == "InProgress" ? "live" : "muted")">@statusText</span>
                }
            </div>
            <div class="bb-team">
                <LogoImg Src="@match.AwayLogoUrl" CssClass="crest" Alt="@match.AwayTeam" />
                <span>@match.AwayTeam</span>
            </div>
        </div>

        <div class="bb-tabs">
            <button type="button" class="bb-tab @(_activeTab == "Events" ? "active" : "")" @onclick='() => SelectTab("Events")'>Events</button>
            <button type="button" class="bb-tab @(_activeTab == "Stats" ? "active" : "")" @onclick='() => SelectTab("Stats")'>Stats</button>
            <button type="button" class="bb-tab @(_activeTab == "Players" ? "active" : "")" @onclick='() => SelectTab("Players")'>Players</button>
        </div>

        @if (_activeTab == "Events")
        {
            @if (_loading)
            {
                <div class="status">Loading…</div>
            }
            else if (_events.Count == 0)
            {
                <div class="muted">No match events available.</div>
            }
            else
            {
                @if (_firstHalf.Count > 0)
                {
                    <div class="match-events-half-header">
                        <span>1st Half</span>
                        <span>@_halfTimeScore</span>
                    </div>
                    @foreach (var e in _firstHalf)
                    {
                        <MatchEventRow Event="e" />
                    }
                }
                @if (_secondHalf.Count > 0)
                {
                    <div class="match-events-half-header">
                        <span>2nd Half</span>
                        <span>@match.HomeScore - @match.AwayScore</span>
                    </div>
                    @foreach (var e in _secondHalf)
                    {
                        <MatchEventRow Event="e" />
                    }
                }
            }
        }
        else if (_activeTab == "Stats")
        {
            @if (_statsLoading)
            {
                <div class="status">Loading…</div>
            }
            else if (_statsError is { } statsError)
            {
                <div class="status error">Error: @statsError</div>
            }
            else if (_statRows.Count == 0)
            {
                <div class="muted">No match stats available yet.</div>
            }
            else
            {
                <div class="match-stats">
                    @foreach (var row in _statRows)
                    {
                        <div class="match-stat-row">
                            <span class="match-stat-value">@row.HomeDisplay</span>
                            <span class="match-stat-label">@row.Label</span>
                            <span class="match-stat-value">@row.AwayDisplay</span>
                        </div>
                        <div class="match-stat-bar @(row.HomeValue + row.AwayValue <= 0 ? "neutral" : "")">
                            <div class="match-stat-bar-home" style="width: @(HomeBarPercent(row).ToString("0.#"))%"></div>
                            <div class="match-stat-bar-away" style="width: @((100 - HomeBarPercent(row)).ToString("0.#"))%"></div>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            @if (_playersLoading)
            {
                <div class="status">Loading…</div>
            }
            else if (_playersError is { } playersError)
            {
                <div class="status error">Error: @playersError</div>
            }
            else if (_homePlayers.Count == 0 && _awayPlayers.Count == 0)
            {
                <div class="muted">No player stats available yet.</div>
            }
            else
            {
                <div class="player-stats">
                    @if (_homePlayers.Count > 0)
                    {
                        <div class="player-stats-team-header">@match.HomeTeam</div>
                        @foreach (var p in _homePlayers)
                        {
                            <PlayerStatRow Player="p" />
                        }
                    }
                    @if (_awayPlayers.Count > 0)
                    {
                        <div class="player-stats-team-header">@match.AwayTeam</div>
                        @foreach (var p in _awayPlayers)
                        {
                            <PlayerStatRow Player="p" />
                        }
                    }
                </div>
            }
        }
    </div>
}

@code {
    private bool _loading = true;
    private Guid _loadedForMatchId;
    private List<MatchEventDto> _events = [];
    private List<MatchEventDto> _firstHalf = [];
    private List<MatchEventDto> _secondHalf = [];
    private string _halfTimeScore = "0 - 0";

    private string _activeTab = "Events";
    private bool _statsLoading;
    private string? _statsError;
    private Guid? _statsLoadedForMatchId;
    private List<MatchStatRowDto> _statRows = [];

    private bool _playersLoading;
    private string? _playersError;
    private Guid? _playersLoadedForMatchId;
    private List<PlayerStatRowDto> _homePlayers = [];
    private List<PlayerStatRowDto> _awayPlayers = [];

    protected override void OnInitialized()
    {
        Summary.Changed += OnSummaryChanged;
    }

    private void OnSummaryChanged()
    {
        if (Summary is { IsOpen: true, Match: { } match } && _loadedForMatchId != match.Id)
        {
            _loadedForMatchId = match.Id;
            _activeTab = "Events";
            _ = LoadEventsAsync(match.Id);
        }

        InvokeAsync(StateHasChanged);
    }

    // Stats/Players are both fetched lazily (only once their tab is actually opened), not alongside
    // Events - most sheet views never touch either, so this avoids extra API-Football-backed calls
    // on every single Match Summary open. Each guarded on its own !loading flag too, so re-tapping a
    // tab while its fetch is still in flight doesn't fire a second concurrent one.
    private void SelectTab(string tab)
    {
        _activeTab = tab;
        if (Summary is not { Match: { } match })
        {
            return;
        }

        if (tab == "Stats" && !_statsLoading && _statsLoadedForMatchId != match.Id)
        {
            _ = LoadStatsAsync(match.Id);
        }
        else if (tab == "Players" && !_playersLoading && _playersLoadedForMatchId != match.Id)
        {
            _ = LoadPlayerStatsAsync(match.Id);
        }
    }

    private async Task LoadPlayerStatsAsync(Guid matchId)
    {
        _playersLoading = true;
        _playersError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var response = await Api.GetPlayerStatsAsync(matchId);
            _homePlayers = response.Home;
            _awayPlayers = response.Away;
            _playersLoadedForMatchId = matchId;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _homePlayers = [];
            _awayPlayers = [];
            _playersError = ex.Message;
        }
        finally
        {
            _playersLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadStatsAsync(Guid matchId)
    {
        _statsLoading = true;
        _statsError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var response = await Api.GetMatchStatsAsync(matchId);
            _statRows = response.Rows;
            // Only marked loaded on success - if this throws, _statsLoadedForMatchId stays unset for
            // this match so re-tapping the Stats tab retries instead of being stuck showing nothing
            // forever (this used to be set unconditionally before the fetch even started).
            _statsLoadedForMatchId = matchId;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Deliberately not narrowed to ApiException - an unmatched exception type here used to
            // skip the loading-flag reset below entirely, leaving the sheet stuck on "Loading…"
            // forever with no way to retry (found live 2026-09-13).
            _statRows = [];
            _statsError = ex.Message;
        }
        finally
        {
            _statsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static double HomeBarPercent(MatchStatRowDto row)
    {
        var total = row.HomeValue + row.AwayValue;
        return total <= 0 ? 50 : row.HomeValue / total * 100;
    }

    private async Task LoadEventsAsync(Guid matchId)
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            _events = await Api.GetMatchEventsAsync(matchId);
        }
        catch (ApiException)
        {
            _events = [];
        }

        // Stoppage-time minutes ("45+2") still belong to the half they extend, not the next one -
        // only a bare "46"+ base minute (no way to distinguish 2nd-half additions from 1st-half
        // ones without the raw base, hence splitting on Base rather than the full string).
        _firstHalf = _events.Where(e => BaseMinute(e.Minute) <= 45).ToList();
        _secondHalf = _events.Where(e => BaseMinute(e.Minute) > 45).ToList();

        // Own Goal is a distinct MatchEvent.Type from Goal (see MatchEventRow) but still counts on
        // the scoreline - Event.Team already carries the team credited with it, not the scorer's
        // own side, so no extra flip is needed here.
        var homeGoalsAtHalf = _firstHalf.Count(e => (e.Type == "Goal" || e.Type == "Own Goal") && e.Team == "Home");
        var awayGoalsAtHalf = _firstHalf.Count(e => (e.Type == "Goal" || e.Type == "Own Goal") && e.Team == "Away");
        _halfTimeScore = $"{homeGoalsAtHalf} - {awayGoalsAtHalf}";

        _loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private static int BaseMinute(string time) =>
        int.TryParse(time.Split('+')[0], out var b) ? b : int.MaxValue;

    // Mirrors MatchCard's LiveClockText - a snapshot of the match state at the moment the sheet was
    // opened, same staleness tradeoff the old page-based version already had.
    private static string? MatchStatusText(UpcomingMatchDto match) => match.Status switch
    {
        "InProgress" when match.IsHalfTime => "HT",
        "InProgress" when match.Minute is { } minute =>
            match.AddedTimeMinutes is { } added && added > 0 ? $"{minute}+{added}'" : $"{minute}'",
        "Finished" => "FT",
        _ => null,
    };

    private void Close() => Summary.Close();

    public void Dispose() => Summary.Changed -= OnSummaryChanged;
}
