@implements IDisposable
@inject MatchSummaryState Summary
@inject ApiClient Api

@if (Summary is { IsOpen: true, Match: { } match })
{
    <div class="match-summary-sheet">
        <div class="page-header-row">
            <button type="button" class="back-btn" @onclick="Close" aria-label="Back">‹</button>
            <h1>Match Details</h1>
        </div>

        <div class="bb-teams-row">
            <div class="bb-team">
                <LogoImg Src="@match.HomeLogoUrl" CssClass="crest" Alt="@match.HomeTeam" />
                <span>@match.HomeTeam</span>
            </div>
            <div class="bb-kickoff">
                <span class="match-events-score">@match.HomeScore - @match.AwayScore</span>
                <span class="muted">@match.KickoffTime.ToLocalTime().ToString("d MMM, HH:mm")</span>
                @if (MatchStatusText(match) is { } statusText)
                {
                    <span class="match-events-status @(match.Status == "InProgress" ? "live" : "muted")">@statusText</span>
                }
                @if (MatchDisplay.PenaltyScoreText(match) is { } pens)
                {
                    <span class="muted">(@pens)</span>
                }
            </div>
            <div class="bb-team">
                <LogoImg Src="@match.AwayLogoUrl" CssClass="crest" Alt="@match.AwayTeam" />
                <span>@match.AwayTeam</span>
            </div>
        </div>

        <div class="bb-tabs">
            @* A match reached before kickoff via its lineups (see MatchCard's EventsAvailable ||
               LineupsAvailable gate) has nothing to show on Events yet - no point offering a tab
               that would only ever say "no match events available". *@
            @if (match.EventsAvailable)
            {
                <button type="button" class="bb-tab @(_activeTab == "Events" ? "active" : "")" @onclick='() => SelectTab("Events")'>Events</button>
            }
            <button type="button" class="bb-tab @(_activeTab == "Lineups" ? "active" : "")" @onclick='() => SelectTab("Lineups")'>Lineups</button>
            <button type="button" class="bb-tab @(_activeTab == "Stats" ? "active" : "")" @onclick='() => SelectTab("Stats")'>Stats</button>
            <button type="button" class="bb-tab @(_activeTab == "Players" ? "active" : "")" @onclick='() => SelectTab("Players")'>Player Stats</button>
        </div>

        @if (_activeTab == "Events")
        {
            @if (_loading)
            {
                <LoadingSpinner />
            }
            else if (_events.Count == 0)
            {
                <div class="muted">No match events available.</div>
            }
            else
            {
                @if (_firstHalf.Count > 0)
                {
                    <div class="match-events-half-header">
                        <span>1st Half</span>
                        <span>@_halfTimeScore</span>
                    </div>
                    @foreach (var e in _firstHalf)
                    {
                        <MatchEventRow Event="e" />
                    }
                }
                @if (_secondHalf.Count > 0)
                {
                    <div class="match-events-half-header">
                        <span>2nd Half</span>
                        <span>@_fullTimeScore</span>
                    </div>
                    @foreach (var e in _secondHalf)
                    {
                        <MatchEventRow Event="e" />
                    }
                }
                @if (_firstExtraTime.Count > 0)
                {
                    <div class="match-events-half-header">
                        <span>1st ET</span>
                        <span>@_extraTimeHalfScore</span>
                    </div>
                    @foreach (var e in _firstExtraTime)
                    {
                        <MatchEventRow Event="e" />
                    }
                }
                @if (_secondExtraTime.Count > 0)
                {
                    <div class="match-events-half-header">
                        <span>2nd ET</span>
                        <span>@match.HomeScore - @match.AwayScore</span>
                    </div>
                    @foreach (var e in _secondExtraTime)
                    {
                        <MatchEventRow Event="e" />
                    }
                }
            }
            @* API-Football has no per-kick shootout event data (confirmed live against a real
               fixture - see ApiFootballSettlementSupportService.MapEventType's vocabulary comment),
               only the final penalty score - so this is a static summary line, not another list of
               MatchEventRows. Shown even when _events is otherwise empty, since a shootout result
               matters regardless of whether any other events happened to resolve. *@
            @if (!_loading && MatchDisplay.PenaltyScoreText(match) is { } penaltiesScore)
            {
                <div class="match-events-half-header">
                    <span>Penalties</span>
                    <span>@penaltiesScore</span>
                </div>
            }
        }
        else if (_activeTab == "Stats")
        {
            @if (_statsLoading)
            {
                <LoadingSpinner />
            }
            else if (_statsError is { } statsError)
            {
                <div class="status error">Error: @statsError</div>
            }
            else if (_statRows.Count == 0)
            {
                <div class="muted">No match stats available yet.</div>
            }
            else
            {
                <div class="match-stats">
                    @foreach (var row in _statRows)
                    {
                        <div class="match-stat-row">
                            <span class="match-stat-value">@row.HomeDisplay</span>
                            <span class="match-stat-label">@row.Label</span>
                            <span class="match-stat-value">@row.AwayDisplay</span>
                        </div>
                        <div class="match-stat-bar @(row.HomeValue + row.AwayValue <= 0 ? "neutral" : "")">
                            <div class="match-stat-bar-home" style="width: @(HomeBarPercent(row).ToString("0.#"))%"></div>
                            <div class="match-stat-bar-away" style="width: @((100 - HomeBarPercent(row)).ToString("0.#"))%"></div>
                        </div>
                    }
                </div>
            }
        }
        else if (_activeTab == "Players")
        {
            @if (_playersLoading)
            {
                <LoadingSpinner />
            }
            else if (_playersError is { } playersError)
            {
                <div class="status error">Error: @playersError</div>
            }
            else if (_homePlayers.Count == 0 && _awayPlayers.Count == 0)
            {
                <div class="muted">No player stats available yet.</div>
            }
            else
            {
                @if (_homePlayers.Count > 0)
                {
                    <div class="player-stats-table">
                        <div class="player-stats-team-header">@match.HomeTeam</div>
                        @PlayerStatsColumnHeader
                        @foreach (var p in _homePlayers)
                        {
                            <PlayerStatRow Player="p" IsHighest="_highestRatedPlayerIds.Contains(p.PlayerId)" IsLowest="_lowestRatedPlayerIds.Contains(p.PlayerId)" />
                        }
                    </div>
                }
                @if (_awayPlayers.Count > 0)
                {
                    <div class="player-stats-table">
                        <div class="player-stats-team-header">@match.AwayTeam</div>
                        @PlayerStatsColumnHeader
                        @foreach (var p in _awayPlayers)
                        {
                            <PlayerStatRow Player="p" IsHighest="_highestRatedPlayerIds.Contains(p.PlayerId)" IsLowest="_lowestRatedPlayerIds.Contains(p.PlayerId)" />
                        }
                    </div>
                }
            }
        }
        else
        {
            @if (_lineupsLoading)
            {
                <LoadingSpinner />
            }
            else if (_lineupsError is { } lineupsError)
            {
                <div class="status error">Error: @lineupsError</div>
            }
            else if (_homeLineup is null && _awayLineup is null)
            {
                <div class="muted">Lineups not announced yet.</div>
            }
            else
            {
                @if (_homeLineup is { } home)
                {
                    <LineupTeam TeamName="@match.HomeTeam" Lineup="home" />
                }
                @if (_awayLineup is { } away)
                {
                    <LineupTeam TeamName="@match.AwayTeam" Lineup="away" />
                }
            }
        }
    </div>
}

@code {
    // Shared between the home and away player tables rather than duplicating the markup twice.
    private static readonly RenderFragment PlayerStatsColumnHeader = @<div class="player-stats-row player-stats-header">
        <span>Player</span>
        <span class="player-stats-stat">Shots</span>
        <span class="player-stats-stat">SOT</span>
        <span class="player-stats-stat">Cards</span>
        <span class="player-stats-stat">Rating</span>
    </div>;

    private bool _loading = true;
    private Guid _loadedForMatchId;
    private List<MatchEventDto> _events = [];
    private List<MatchEventDto> _firstHalf = [];
    private List<MatchEventDto> _secondHalf = [];
    private List<MatchEventDto> _firstExtraTime = [];
    private List<MatchEventDto> _secondExtraTime = [];
    private string _halfTimeScore = "0 - 0";
    private string _fullTimeScore = "0 - 0";
    private string _extraTimeHalfScore = "0 - 0";

    private string _activeTab = "Events";
    private bool _statsLoading;
    private string? _statsError;
    private Guid? _statsLoadedForMatchId;
    private List<MatchStatRowDto> _statRows = [];

    private bool _playersLoading;
    private string? _playersError;
    private Guid? _playersLoadedForMatchId;
    private List<PlayerStatRowDto> _homePlayers = [];
    private List<PlayerStatRowDto> _awayPlayers = [];

    // Match-wide (not per-team) - highlights the single standout and single worst performer of the
    // whole game, like a Man of the Match badge, rather than a fixed rating threshold that marks
    // half a beaten team red regardless of how the other side did. Ties (2+ players sharing the
    // exact top/bottom rating) all get highlighted, not just the first found.
    private HashSet<long> _highestRatedPlayerIds = [];
    private HashSet<long> _lowestRatedPlayerIds = [];

    private bool _lineupsLoading;
    private string? _lineupsError;
    private Guid? _lineupsLoadedForMatchId;
    private TeamLineupDto? _homeLineup;
    private TeamLineupDto? _awayLineup;

    protected override void OnInitialized()
    {
        Summary.Changed += OnSummaryChanged;
    }

    private void OnSummaryChanged()
    {
        if (Summary is { IsOpen: true, Match: { } match } && _loadedForMatchId != match.Id)
        {
            _loadedForMatchId = match.Id;

            if (match.EventsAvailable)
            {
                _activeTab = "Events";
                _ = LoadEventsAsync(match.Id);
            }
            else
            {
                // Reached before kickoff via its lineups only (Events tab isn't even shown - see the
                // tab bar above) - opens straight on Lineups instead of a tab that isn't there.
                _activeTab = "Lineups";
                _ = LoadLineupsAsync(match.Id);
            }
        }

        InvokeAsync(StateHasChanged);
    }

    // Stats/Players/Lineups are all fetched lazily (only once their tab is actually opened), not
    // alongside Events - most sheet views never touch any of them, so this avoids extra
    // API-Football-backed calls on every single Match Summary open. Each guarded on its own
    // !loading flag too, so re-tapping a tab while its fetch is still in flight doesn't fire a
    // second concurrent one.
    private void SelectTab(string tab)
    {
        _activeTab = tab;
        if (Summary is not { Match: { } match })
        {
            return;
        }

        if (tab == "Stats" && !_statsLoading && _statsLoadedForMatchId != match.Id)
        {
            _ = LoadStatsAsync(match.Id);
        }
        else if (tab == "Players" && !_playersLoading && _playersLoadedForMatchId != match.Id)
        {
            _ = LoadPlayerStatsAsync(match.Id);
        }
        else if (tab == "Lineups" && !_lineupsLoading && _lineupsLoadedForMatchId != match.Id)
        {
            _ = LoadLineupsAsync(match.Id);
        }
    }

    private async Task LoadLineupsAsync(Guid matchId)
    {
        _lineupsLoading = true;
        _lineupsError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var response = await Api.GetLineupsAsync(matchId);
            _homeLineup = response.Home;
            _awayLineup = response.Away;
            _lineupsLoadedForMatchId = matchId;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _homeLineup = null;
            _awayLineup = null;
            _lineupsError = ex.Message;
        }
        finally
        {
            _lineupsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadPlayerStatsAsync(Guid matchId)
    {
        _playersLoading = true;
        _playersError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var response = await Api.GetPlayerStatsAsync(matchId);
            _homePlayers = response.Home;
            _awayPlayers = response.Away;
            (_highestRatedPlayerIds, _lowestRatedPlayerIds) = RatingExtremes(_homePlayers, _awayPlayers);
            _playersLoadedForMatchId = matchId;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _homePlayers = [];
            _awayPlayers = [];
            _highestRatedPlayerIds = [];
            _lowestRatedPlayerIds = [];
            _playersError = ex.Message;
        }
        finally
        {
            _playersLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadStatsAsync(Guid matchId)
    {
        _statsLoading = true;
        _statsError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var response = await Api.GetMatchStatsAsync(matchId);
            _statRows = response.Rows;
            // Only marked loaded on success - if this throws, _statsLoadedForMatchId stays unset for
            // this match so re-tapping the Stats tab retries instead of being stuck showing nothing
            // forever (this used to be set unconditionally before the fetch even started).
            _statsLoadedForMatchId = matchId;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Deliberately not narrowed to ApiException - an unmatched exception type here used to
            // skip the loading-flag reset below entirely, leaving the sheet stuck on "Loading…"
            // forever with no way to retry (found live 2026-09-13).
            _statRows = [];
            _statsError = ex.Message;
        }
        finally
        {
            _statsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // No highlight at all when every rated player shares the same value (e.g. only one player has
    // a rating yet, mid-match) - "highest" and "lowest" would otherwise both resolve to the same
    // player, marking them green and red at once.
    private static (HashSet<long> Highest, HashSet<long> Lowest) RatingExtremes(
        List<PlayerStatRowDto> home, List<PlayerStatRowDto> away)
    {
        var rated = home.Concat(away)
            .Select(p => (p.PlayerId, Rating: double.TryParse(p.Rating, out var r) ? (double?)r : null))
            .Where(p => p.Rating is not null)
            .Select(p => (p.PlayerId, Rating: p.Rating!.Value))
            .ToList();

        if (rated.Count == 0)
        {
            return ([], []);
        }

        var max = rated.Max(p => p.Rating);
        var min = rated.Min(p => p.Rating);
        if (max == min)
        {
            return ([], []);
        }

        return (
            rated.Where(p => p.Rating == max).Select(p => p.PlayerId).ToHashSet(),
            rated.Where(p => p.Rating == min).Select(p => p.PlayerId).ToHashSet());
    }

    private static double HomeBarPercent(MatchStatRowDto row)
    {
        var total = row.HomeValue + row.AwayValue;
        return total <= 0 ? 50 : row.HomeValue / total * 100;
    }

    private async Task LoadEventsAsync(Guid matchId)
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            _events = await Api.GetMatchEventsAsync(matchId);
        }
        catch (ApiException)
        {
            _events = [];
        }

        // Stoppage-time minutes ("45+2") still belong to the half they extend, not the next one -
        // only a bare "46"+ base minute (no way to distinguish 2nd-half additions from 1st-half
        // ones without the raw base, hence splitting on Base rather than the full string). Extra
        // time (API-Football numbers it 91-120, not a fresh "1+") gets its own bucket rather than
        // being lumped into "2nd Half" - a goal at minute 105 is not a 2nd-half goal.
        //
        // Gated on Match.WentToExtraTime, not just "minute > 90" alone - normal second-half added
        // time is supposed to come through as elapsed=90/extra=N (formatting to "90+4", which
        // BaseMinute correctly reads as 90), but that per-event split has only been confirmed live
        // for the *fixture* clock, not for an actual stoppage-time goal event - if API-Football ever
        // reports one as a bare elapsed=94 instead, WentToExtraTime (a real per-match fact, not a
        // per-event minute format) stops it from being wrongly filed under Extra Time.
        // Extra time is itself played as two 15-minute periods (91-105, 106-120), same as the two
        // regular halves - split the same way rather than lumping all of it into one block.
        var wentToExtraTime = Summary.Match?.WentToExtraTime ?? false;
        _firstHalf = _events.Where(e => BaseMinute(e.Minute) <= 45).ToList();
        _secondHalf = _events.Where(e => BaseMinute(e.Minute) > 45 && (!wentToExtraTime || BaseMinute(e.Minute) <= 90)).ToList();
        _firstExtraTime = wentToExtraTime ? _events.Where(e => BaseMinute(e.Minute) is > 90 and <= 105).ToList() : [];
        _secondExtraTime = wentToExtraTime ? _events.Where(e => BaseMinute(e.Minute) > 105).ToList() : [];

        // Own Goal is a distinct MatchEvent.Type from Goal (see MatchEventRow) but still counts on
        // the scoreline - Event.Team already carries the team credited with it, not the scorer's
        // own side, so no extra flip is needed here.
        var homeGoalsAtHalf = _firstHalf.Count(e => (e.Type == "Goal" || e.Type == "Own Goal") && e.Team == "Home");
        var awayGoalsAtHalf = _firstHalf.Count(e => (e.Type == "Goal" || e.Type == "Own Goal") && e.Team == "Away");
        _halfTimeScore = $"{homeGoalsAtHalf} - {awayGoalsAtHalf}";

        // Derived from events rather than read off Match.HomeScore/AwayScore, same reasoning as
        // _halfTimeScore above - the stored score is the final (AET-inclusive) one, so it's only
        // correct as "the 90-minute score" when extra time never happened. Counting actual goal
        // events up to and including minute 90 is correct either way.
        var upToNinety = _firstHalf.Concat(_secondHalf);
        var homeGoalsAt90 = upToNinety.Count(e => (e.Type == "Goal" || e.Type == "Own Goal") && e.Team == "Home");
        var awayGoalsAt90 = upToNinety.Count(e => (e.Type == "Goal" || e.Type == "Own Goal") && e.Team == "Away");
        _fullTimeScore = $"{homeGoalsAt90} - {awayGoalsAt90}";

        // Same reasoning again for the break between the two ET periods - counts on top of the
        // 90-minute tally rather than assuming anything about the stored final score.
        var homeGoalsAt105 = homeGoalsAt90 + _firstExtraTime.Count(e => (e.Type == "Goal" || e.Type == "Own Goal") && e.Team == "Home");
        var awayGoalsAt105 = awayGoalsAt90 + _firstExtraTime.Count(e => (e.Type == "Goal" || e.Type == "Own Goal") && e.Team == "Away");
        _extraTimeHalfScore = $"{homeGoalsAt105} - {awayGoalsAt105}";

        _loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private static int BaseMinute(string time) =>
        int.TryParse(time.Split('+')[0], out var b) ? b : int.MaxValue;

    // Mirrors MatchCard's LiveClockText - a snapshot of the match state at the moment the sheet was
    // opened, same staleness tradeoff the old page-based version already had.
    private static string? MatchStatusText(UpcomingMatchDto match) => match.Status switch
    {
        "InProgress" when match.IsHalfTime => "HT",
        "InProgress" when match.Minute is { } minute =>
            match.AddedTimeMinutes is { } added && added > 0 ? $"{minute}+{added}'" : $"{minute}'",
        "Finished" => MatchDisplay.FinishedLabel(match),
        _ => null,
    };

    private void Close() => Summary.Close();

    public void Dispose() => Summary.Changed -= OnSummaryChanged;
}
