@inject NavigationManager Nav

@* Display-only - PromoCarousel decides whether a spin is available. *@
<button type="button" class="spin-banner" @onclick='() => Nav.NavigateTo("/daily-spinner")'>
    <div class="spin-banner-wheel">
        <div class="spin-banner-pointer"></div>
        <div class="spin-banner-wheel-disc">
            @for (var i = 0; i < SpinSegments.All.Length; i++)
            {
                var segment = SpinSegments.All[i];
                <div class="spin-banner-segment" style="--segment-angle: @(i * (360.0 / SpinSegments.All.Length))deg">
                    <span class="spin-banner-segment-icon @(segment.Icon == "2x" ? "spin-banner-icon-badge" : "")">@segment.Icon</span>
                </div>
            }
            <div class="spin-banner-wheel-center">
                <img src="_content/FullTime.App.Shared/football.png" alt="" class="spin-banner-wheel-center-ball" />
            </div>
        </div>
    </div>
    <div class="spin-banner-text">
        <div class="spin-banner-title">FREE <span class="spin-banner-accent">SPIN</span></div>
        <div class="spin-banner-badge">🎁 Available now</div>
    </div>
    <div class="spin-banner-arrow">›</div>
</button>
