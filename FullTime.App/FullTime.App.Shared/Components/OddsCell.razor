@implements IDisposable
@inject BetSlipState Slip

<span class="@CssClass" @onclick="OnClickAsync">@Text</span>

@code {
    [Parameter] public Guid MatchId { get; set; }
    [Parameter] public string MatchStatus { get; set; } = "";
    [Parameter] public string Pick { get; set; } = "";
    [Parameter] public decimal? Odds { get; set; }
    [Parameter] public string HomeTeam { get; set; } = "";
    [Parameter] public string AwayTeam { get; set; } = "";
    [Parameter] public DateTime KickoffTime { get; set; }

    private bool Clickable => Odds is not null && MatchStatus == "Upcoming";
    private string Text => Odds is null ? "—" : FormatOdds(Odds.Value);

    private string CssClass
    {
        get
        {
            if (!Clickable) return "odds disabled";
            var cls = "odds clickable";
            if (Slip.GetPick(MatchId) == Pick) cls += " selected";
            return cls;
        }
    }

    protected override void OnInitialized()
    {
        Slip.Changed += StateHasChanged;
    }

    private async Task OnClickAsync()
    {
        if (!Clickable) return;
        await Slip.ToggleMatchResultAsync(MatchId, Pick, Odds!.Value, HomeTeam, AwayTeam, KickoffTime);
    }

    public static string FormatOdds(decimal decimalOdds)
    {
        var profit = decimalOdds - 1;

        // Real fractional odds are quoted as simple ratios (6/1, 11/4, ...), not the exact
        // reduction of an arbitrary 2dp decimal price - try small denominators first (simplest
        // first) and accept the first one within 4% of the real price, e.g. 7.81 -> "8/1" instead
        // of "781/100". Falls through to the exact reduction below when nothing that simple is
        // close enough. Display only - PlaceBetAsync/CombinedOdds always use the real decimal
        // Price/Odds, never this string, so this never affects what a bet actually settles at.
        if (profit > 0)
        {
            for (var denominator = 1; denominator <= 20; denominator++)
            {
                var numerator = Math.Round(profit * denominator, MidpointRounding.AwayFromZero);
                if (numerator <= 0)
                {
                    continue;
                }

                if (Math.Abs(numerator / denominator - profit) / profit <= 0.04m)
                {
                    return $"{(long)numerator}/{denominator}";
                }
            }
        }

        // Odds are stored to 2 decimal places, so scale by 100 before reducing to avoid float noise.
        var exactNumerator = (long)Math.Round(profit * 100);
        var exactDenominator = 100L;
        var divisor = Gcd(exactNumerator, exactDenominator);
        if (divisor != 0)
        {
            exactNumerator /= divisor;
            exactDenominator /= divisor;
        }
        return $"{exactNumerator}/{exactDenominator}";
    }

    private static long Gcd(long a, long b) => b == 0 ? a : Gcd(b, a % b);

    public void Dispose()
    {
        Slip.Changed -= StateHasChanged;
    }
}
